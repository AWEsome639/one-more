/**
 * 数字键 —— 拆分成两个数
 *
 * 玩法：目标数拆成两部分，一部分已给出，四选一补上另一部分。共 10 题。
 * 胜负：答对 ≥ 8 题 ⇒ 通关；否则失败。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const ROUNDS: number = 10;
const PASS: number = 8;
const PICK: number = 4;
const NEXT_MS: number = 400;

function randInt(lo: number, hi: number): number {
  return lo + Math.floor(Math.random() * (hi - lo + 1));
}

@Component
export struct GNumberBonds {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：ROUNDS 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.sizeNow(ROUNDS);
  onFinish: (r: GameResult) => void = () => {};

  @State private opts: number[] = [];
  @State private ans: number = -1;
  @State private picked: number = -1;
  @State private target: number = 0;
  @State private shown: number = 0;
  @State private hideFirst: boolean = true;
  @State private round: number = 1;
  @State private right: number = 0;
  @State private score: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private msg: string = '';

  private startAt: number = 0;
  private nextTo: number = -1;
  private finished: boolean = false;
  private slots: number[] = [0, 1, 2, 3];

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.startAt = Date.now();
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(ROUNDS);
    this.reset();
  }

  aboutToDisappear(): void {
    if (this.nextTo >= 0) {
      clearTimeout(this.nextTo);
      this.nextTo = -1;
    }
  }

  private reset(): void {
    if (this.nextTo >= 0) {
      clearTimeout(this.nextTo);
      this.nextTo = -1;
    }
    this.round = 1;
    this.right = 0;
    this.score = 0;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.startAt = Date.now();
    this.msg = '目标数 = 左半 + 右半，把缺的那半补上';
    this.ask();
  }

  private ask(): void {
    const t: number = randInt(5, 18);
    const a: number = randInt(1, t - 1);
    const b: number = t - a;
    this.target = t;
    this.hideFirst = Math.random() < 0.5;
    this.shown = this.hideFirst ? b : a;
    const truth: number = this.hideFirst ? a : b;
    const pool: number[] = [truth + 1, truth - 1, truth + 2, t - truth, truth + 3, truth - 2];
    const opts: number[] = [truth];
    for (let i = 0; i < pool.length && opts.length < PICK; i++) {
      if (pool[i] >= 1 && pool[i] <= t - 1 && opts.indexOf(pool[i]) < 0) {
        opts.push(pool[i]);
      }
    }
    for (let i = opts.length - 1; i > 0; i--) {
      const j: number = Math.floor(Math.random() * (i + 1));
      const tmp: number = opts[i];
      opts[i] = opts[j];
      opts[j] = tmp;
    }
    this.opts = opts;
    this.ans = opts.indexOf(truth);
    this.picked = -1;
  }

  private pick(i: number): void {
    if (this.picked >= 0 || this.over) {
      return;
    }
    this.picked = i;
    if (i === this.ans) {
      this.right = this.right + 1;
      this.score = this.score + 100;
      this.msg = '✅ ' + this.target + ' = ' + this.shown + ' + ' + this.opts[this.ans];
    } else {
      this.msg = TG('❌ 应该是 ') + this.opts[this.ans];
    }
    if (this.nextTo >= 0) {
      clearTimeout(this.nextTo);
    }
    this.nextTo = setTimeout(() => {
      this.nextTo = -1;
      this.advance();
    }, NEXT_MS);
  }

  private advance(): void {
    if (this.over) {
      return;
    }
    if (this.round >= this.diffTotal) {
      const ok: boolean = this.right >= PASS;
      this.msg = ok ? TG('🎉 答对 ') + this.right + '/' + this.diffTotal + ' 题，通关！'
        : TG('答对 ') + this.right + '/' + this.diffTotal + ' 题，还差一点';
      this.finish(ok);
      return;
    }
    this.round = this.round + 1;
    this.ask();
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    this.over = true;
    this.won = solved;
    const r: GameResult = {
      gameId: 'number_bonds',
      solved: solved,
      score: this.score,
      durationMs: Date.now() - this.startAt,
      levelReached: this.right
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  private optBg(i: number): string {
    if (this.picked < 0) {
      return this.theme.surface;
    }
    if (i === this.ans) {
      return Palette.teal;
    }
    return i === this.picked ? Palette.rose : this.theme.surface;
  }

  private optInk(i: number): string {
    if (this.picked < 0) {
      return this.theme.ink;
    }
    if (i === this.ans) {
      return '#FFFFFF';
    }
    return i === this.picked ? '#FFFFFF' : this.theme.inkFaint;
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat('第几题', this.round + '/' + this.diffTotal)
        this.stat(TG('答对'), this.right + '/' + PASS)
        this.stat(TG('得分'), String(this.score))
      }.width('100%')

      Column({ space: Space.xs }) {
        Text(String(this.target)).fontSize(FontSize.hero).fontWeight(FontWeight.Bold).fontColor(Palette.teal)
        Text('╱  ╲').fontSize(FontSize.lg).fontColor(this.theme.inkFaint)
        Row({ space: Space.lg }) {
          this.bond(this.hideFirst, this.shown)
          this.bond(!this.hideFirst, this.shown)
        }.width('100%').justifyContent(FlexAlign.Center)
      }.width('100%').padding(Space.lg).backgroundColor(this.theme.surface).borderRadius(Radius.lg).shadow(Shadow.card)

      Column({ space: Space.sm }) {
        ForEach(this.slots, (i: number) => {
          Row({ space: Space.sm }) {
            Text(String(i + 1)).fontSize(FontSize.sm).fontWeight(FontWeight.Bold).fontColor(this.theme.inkFaint)
            Text(String(this.opts[i])).fontSize(FontSize.xl).fontWeight(FontWeight.Bold).fontColor(this.optInk(i)).layoutWeight(1)
          }.width('100%').height(50).padding({ left: Space.md, right: Space.md }).backgroundColor(this.optBg(i)).borderRadius(Radius.md).shadow(Shadow.card).animation({ duration: Motion.fast, curve: Motion.snap() }).onClick(() => {
            this.pick(i);
          })
        }, (i: number) => 'nb' + i)
      }.width('100%')

      Text(this.msg).fontSize(FontSize.sm).fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft).width('100%')

      Button(this.over ? (this.won ? TG('已通关 🎉') : TG('再来一局')) : TG('重开')).fontSize(FontSize.md).fontColor(Color.White).backgroundColor(Palette.teal).borderRadius(Radius.md).width('100%').height(46).onClick(() => {
          this.reset();
        })
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }.layoutWeight(1).padding(Space.sm).backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  bond(hidden: boolean, v: number) {
    Text(hidden ? '?' : String(v)).fontSize(FontSize.xxl).fontWeight(FontWeight.Bold).fontColor(hidden ? '#FFFFFF' : this.theme.ink).textAlign(TextAlign.Center).width(84).height(64).backgroundColor(hidden ? Palette.teal : this.theme.surfaceAlt).borderRadius(Radius.md)
  }
}
