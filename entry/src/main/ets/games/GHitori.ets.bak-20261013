/**
 * 数壹（Hitori）⬛
 *
 * 规则：涂黑一些格子，使 ——
 *   ① 每行每列的**未涂黑**数字都不重复；
 *   ② 涂黑的格子不能上下左右相邻；
 *   ③ 所有未涂黑的格子要连成一片。
 * 胜负：三条全满足 = 通关；步数用尽 = 失败。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 6;
const MAX_MOVES: number = 120;

interface HitoriGen {
  vals: number[];
  shade: boolean[];
}

function shuffleArr(a: number[]): void {
  for (let i = a.length - 1; i > 0; i--) {
    const j: number = Math.floor(Math.random() * (i + 1));
    const t: number = a[i];
    a[i] = a[j];
    a[j] = t;
  }
}

/** 循环拉丁方 + 三重打乱 */
function latinSquare(): number[] {
  const rows: number[] = [];
  const cols: number[] = [];
  const syms: number[] = [];
  for (let i = 0; i < N; i++) {
    rows.push(i);
    cols.push(i);
    syms.push(i + 1);
  }
  shuffleArr(rows);
  shuffleArr(cols);
  shuffleArr(syms);
  const out: number[] = new Array<number>(N * N).fill(0);
  for (let r = 0; r < N; r++) {
    for (let c = 0; c < N; c++) {
      out[r * N + c] = syms[(rows[r] + cols[c]) % N];
    }
  }
  return out;
}

function hitoriGen(): HitoriGen {
  for (let t = 0; t < 400; t++) {
    const L: number[] = latinSquare();
    const order: number[] = [];
    for (let i = 0; i < N * N; i++) {
      order.push(i);
    }
    shuffleArr(order);
    const want: number = N + Math.floor(Math.random() * (N + 1));
    const shade: boolean[] = new Array<boolean>(N * N).fill(false);
    let cnt: number = 0;
    for (let k = 0; k < order.length && cnt < want; k++) {
      const i: number = order[k];
      const r: number = Math.floor(i / N);
      const c: number = i - r * N;
      let bad: boolean = false;
      if (c > 0 && shade[i - 1]) {
        bad = true;
      }
      if (c < N - 1 && shade[i + 1]) {
        bad = true;
      }
      if (r > 0 && shade[i - N]) {
        bad = true;
      }
      if (r < N - 1 && shade[i + N]) {
        bad = true;
      }
      if (bad) {
        continue;
      }
      shade[i] = true;
      cnt++;
    }
    if (cnt === 0) {
      continue;
    }
    // 白格连通
    let start: number = -1;
    let whites: number = 0;
    for (let i = 0; i < N * N; i++) {
      if (!shade[i]) {
        if (start < 0) {
          start = i;
        }
        whites++;
      }
    }
    if (start < 0) {
      continue;
    }
    const seen: boolean[] = new Array<boolean>(N * N).fill(false);
    const st: number[] = [start];
    seen[start] = true;
    let vis: number = 0;
    while (st.length > 0) {
      const k: number = st[st.length - 1];
      st.splice(st.length - 1, 1);
      vis++;
      const r: number = Math.floor(k / N);
      const c: number = k - r * N;
      if (c > 0 && !shade[k - 1] && !seen[k - 1]) {
        seen[k - 1] = true;
        st.push(k - 1);
      }
      if (c < N - 1 && !shade[k + 1] && !seen[k + 1]) {
        seen[k + 1] = true;
        st.push(k + 1);
      }
      if (r > 0 && !shade[k - N] && !seen[k - N]) {
        seen[k - N] = true;
        st.push(k - N);
      }
      if (r < N - 1 && !shade[k + N] && !seen[k + N]) {
        seen[k + N] = true;
        st.push(k + N);
      }
    }
    if (vis !== whites) {
      continue;
    }
    // 黑格数字取自相邻白格 ⇒ 每行每列必然出现重复，必须涂黑
    const vals: number[] = L.slice();
    let ok: boolean = true;
    for (let i = 0; i < N * N; i++) {
      if (!shade[i]) {
        continue;
      }
      const r: number = Math.floor(i / N);
      const c: number = i - r * N;
      const nbs: number[] = [];
      if (c > 0 && !shade[i - 1]) {
        nbs.push(i - 1);
      }
      if (c < N - 1 && !shade[i + 1]) {
        nbs.push(i + 1);
      }
      if (r > 0 && !shade[i - N]) {
        nbs.push(i - N);
      }
      if (r < N - 1 && !shade[i + N]) {
        nbs.push(i + N);
      }
      if (nbs.length === 0) {
        ok = false;
        break;
      }
      vals[i] = L[nbs[Math.floor(Math.random() * nbs.length)]];
    }
    if (!ok) {
      continue;
    }
    // 校验：白格数字在行列内不重复
    for (let r = 0; r < N; r++) {
      const sv: boolean[] = new Array<boolean>(N + 1).fill(false);
      for (let c = 0; c < N; c++) {
        if (shade[r * N + c]) {
          continue;
        }
        const v: number = vals[r * N + c];
        if (sv[v]) {
          ok = false;
          break;
        }
        sv[v] = true;
      }
    }
    for (let c = 0; c < N; c++) {
      const sv: boolean[] = new Array<boolean>(N + 1).fill(false);
      for (let r = 0; r < N; r++) {
        if (shade[r * N + c]) {
          continue;
        }
        const v: number = vals[r * N + c];
        if (sv[v]) {
          ok = false;
          break;
        }
        sv[v] = true;
      }
    }
    if (ok) {
      return { vals: vals, shade: shade };
    }
  }
  const vals: number[] = latinSquare();
  return { vals: vals, shade: new Array<boolean>(N * N).fill(false) };
}

@Component
export struct GHitori {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（lives）：MAX_MOVES 按难度换算
  @State private diffTotal: number = GameDiff.livesNow(MAX_MOVES);
  onFinish: (r: GameResult) => void = () => {};

  @State private vals: number[] = [];
  @State private shade: boolean[] = [];
  @State private moves: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private pressed: number = -1;

  private startAt: number = 0;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.livesNow(MAX_MOVES);
    this.reset();
  }

  private reset(): void {
    const g: HitoriGen = hitoriGen();
    this.vals = g.vals;
    this.shade = new Array<boolean>(N * N).fill(false);
    this.moves = 0;
    this.over = false;
    this.won = false;
    this.pressed = -1;
    this.startAt = Date.now();
  }

  private shaded(): number {
    let n: number = 0;
    for (let i = 0; i < this.shade.length; i++) {
      if (this.shade[i]) {
        n++;
      }
    }
    return n;
  }

  private dupCount(): number {
    let n: number = 0;
    for (let r = 0; r < N; r++) {
      const sv: boolean[] = new Array<boolean>(N + 1).fill(false);
      for (let c = 0; c < N; c++) {
        if (this.shade[r * N + c]) {
          continue;
        }
        const v: number = this.vals[r * N + c];
        if (sv[v]) {
          n++;
        } else {
          sv[v] = true;
        }
      }
    }
    for (let c = 0; c < N; c++) {
      const sv: boolean[] = new Array<boolean>(N + 1).fill(false);
      for (let r = 0; r < N; r++) {
        if (this.shade[r * N + c]) {
          continue;
        }
        const v: number = this.vals[r * N + c];
        if (sv[v]) {
          n++;
        } else {
          sv[v] = true;
        }
      }
    }
    return n;
  }

  private adjCount(): number {
    let n: number = 0;
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        if (!this.shade[r * N + c]) {
          continue;
        }
        if (c + 1 < N && this.shade[r * N + c + 1]) {
          n++;
        }
        if (r + 1 < N && this.shade[(r + 1) * N + c]) {
          n++;
        }
      }
    }
    return n;
  }

  private whiteLinked(): boolean {
    let start: number = -1;
    let whites: number = 0;
    for (let i = 0; i < N * N; i++) {
      if (!this.shade[i]) {
        if (start < 0) {
          start = i;
        }
        whites++;
      }
    }
    if (start < 0) {
      return false;
    }
    const seen: boolean[] = new Array<boolean>(N * N).fill(false);
    const st: number[] = [start];
    seen[start] = true;
    let cnt: number = 0;
    while (st.length > 0) {
      const k: number = st[st.length - 1];
      st.splice(st.length - 1, 1);
      cnt++;
      const r: number = Math.floor(k / N);
      const c: number = k - r * N;
      if (c > 0 && !this.shade[k - 1] && !seen[k - 1]) {
        seen[k - 1] = true;
        st.push(k - 1);
      }
      if (c < N - 1 && !this.shade[k + 1] && !seen[k + 1]) {
        seen[k + 1] = true;
        st.push(k + 1);
      }
      if (r > 0 && !this.shade[k - N] && !seen[k - N]) {
        seen[k - N] = true;
        st.push(k - N);
      }
      if (r < N - 1 && !this.shade[k + N] && !seen[k + N]) {
        seen[k + N] = true;
        st.push(k + N);
      }
    }
    return cnt === whites;
  }

  private isSolved(): boolean {
    return this.dupCount() === 0 && this.adjCount() === 0 && this.whiteLinked();
  }

  private flat(): number {
    const n: number = this.dupCount() + this.adjCount();
    return this.whiteLinked() ? n : n + 1;
  }

  private tap(i: number): void {
    if (this.over) {
      return;
    }
    const s: boolean[] = this.shade.slice();
    s[i] = !s[i];
    this.shade = s;
    this.moves++;
    if (this.isSolved()) {
      this.over = true;
      this.won = true;
      this.finish(true);
      return;
    }
    if (this.moves >= this.diffTotal) {
      this.over = true;
      this.finish(false);
    }
  }

  private finish(solved: boolean): void {
    const r: GameResult = {
      gameId: 'hitori',
      solved: solved,
      score: solved ? Math.max(200, 1300 - this.moves * 10) : this.shaded() * 50,
      durationMs: Date.now() - this.startAt,
      levelReached: this.shaded()
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.md }) {
        this.infoBox('已涂黑', String(this.shaded()))
        this.infoBox('违规', String(this.flat()))
        this.infoBox(TG('步数'), String(this.moves))
      }
      .width('100%')

      Column({ space: 2 }) {
        ForEach([0, 1, 2, 3, 4, 5], (r: number) => {
          Row({ space: 2 }) {
            ForEach([0, 1, 2, 3, 4, 5], (c: number) => {
              this.cellBox(r * N + c)
            }, (c: number) => 'ht' + r + '-' + c)
          }
          .width('100%')
        }, (r: number) => 'htr' + r)
      }
      .width('100%')
      .padding(Space.xs)
      .backgroundColor(this.theme.surfaceAlt)
      .borderRadius(Radius.md)

      Row({ space: Space.md }) {
        Button(this.over ? (this.won ? TG('🎉 已通关') : TG('已结束')) : '点格子涂黑 / 取消')
          .fontSize(FontSize.sm)
          .fontColor(this.theme.inkSoft)
          .backgroundColor(this.theme.surfaceAlt)
          .borderRadius(Radius.md)
          .layoutWeight(1)
          .height(44)
          .enabled(false)
        Button(TG('重开'))
          .fontSize(FontSize.md)
          .fontColor(Color.White)
          .backgroundColor(Palette.primary)
          .borderRadius(Radius.md)
          .width(96)
          .height(44)
          .onClick(() => {
            this.reset();
          })
      }
      .width('100%')

      Text('涂黑的格子仍显示数字；每行每列剩下的数字不能重复，白格要连成一片')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  infoBox(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value)
        .fontSize(FontSize.lg)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }

  @Builder
  cellBox(i: number) {
    Stack() {
      Text(String(this.vals[i]))
        .fontSize(FontSize.xl)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.shade[i] ? (this.theme.isDark ? '#64748B' : '#94A3B8') : this.theme.ink)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.shade[i] ? (this.theme.isDark ? '#0B0B0B' : '#334155') : this.theme.surface)
    .borderRadius(Radius.xs)
    .scale({
      x: this.pressed === i ? Motion.pressScale : 1,
      y: this.pressed === i ? Motion.pressScale : 1
    })
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onTouch((e: TouchEvent) => {
      if (e.type === TouchType.Down) {
        this.pressed = i;
      } else if (e.type === TouchType.Up || e.type === TouchType.Cancel) {
        this.pressed = -1;
      }
    })
    .onClick(() => {
      this.tap(i);
    })
  }
}
