/** 字母算术（Crypto Arithmetic）—— 字母代表数字
 *  玩法：给五个字母指派互不相同的数字（首位不为 0）让等式成立。过关判据：5 题解出 ≥ 4 题
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const ROUNDS: number = 5;
const PASS: number = 4;

interface Crypto { form: number; sol: number[] }

function distinct(v: number[]): boolean {
  for (let i = 0; i < v.length; i++) {
    for (let j = i + 1; j < v.length; j++) {
      if (v[i] === v[j]) { return false; }
    }
  }
  return true;
}

function makeCrypto(): Crypto {
  const form: number = Math.random() < 0.5 ? 0 : 1;
  for (let attempt = 0; attempt < 500; attempt++) {
    const a: number = 1 + Math.floor(Math.random() * 9);
    const b: number = Math.floor(Math.random() * 10);
    const c: number = form === 0 ? 1 + Math.floor(Math.random() * 9) : 2 + Math.floor(Math.random() * 8);
    const lhs: number = form === 0 ? (10 * a + b) + c : (10 * a + b) * c;
    if (lhs < 10 || lhs > 99) { continue; }
    const d: number = Math.floor(lhs / 10);
    const e: number = lhs % 10;
    const five: number[] = [a, b, c, d, e];
    if (distinct(five)) { return { form: form, sol: five }; }
  }
  return form === 0 ? { form: 0, sol: [1, 4, 6, 2, 0] } : { form: 1, sol: [3, 9, 2, 7, 8] };
}

@Component
export struct GCryptoArithmetic {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：ROUNDS 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.sizeNow(ROUNDS);
  onFinish: (r: GameResult) => void = () => {};

  @State private puz: Crypto = { form: 0, sol: [1, 4, 6, 2, 0] };
  @State private slots: number[] = [-1, -1, -1, -1, -1];
  @State private sel: number = 0;
  @State private round: number = 0;
  @State private right: number = 0;
  @State private score: number = 0;
  @State private over: boolean = false;
  @State private tip: string = '选一个字母，再点数字';

  private startAt: number = 0;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.startAt = Date.now();
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(ROUNDS);
     this.reset(); }

  private reset(): void {
    this.startAt = Date.now();
    this.round = 0;
    this.right = 0;
    this.score = 0;
    this.over = false;
    this.tip = '选一个字母，再点数字';
    this.load();
  }

  private load(): void {
    this.puz = makeCrypto();
    this.slots = [-1, -1, -1, -1, -1];
    this.sel = 0;
  }

  private letterAt(k: number): string {
    return ['A', 'B', 'C', 'D', 'E'][k];
  }

  private usedDigit(d: number): boolean {
    for (let k = 0; k < 5; k++) {
      if (this.slots[k] === d) { return true; }
    }
    return false;
  }

  private tapDigit(d: number): void {
    if (this.over) { return; }
    const next: number[] = this.slots.slice();
    next[this.sel] = d;
    this.slots = next;
    this.check();
    if (!this.over && this.sel >= 0) {
      this.sel = (this.sel + 1) % 5;
    }
  }

  private check(): void {
    for (let k = 0; k < 5; k++) {
      if (this.slots[k] < 0) { return; }
    }
    const a: number = this.slots[0];
    const b: number = this.slots[1];
    const c: number = this.slots[2];
    const d: number = this.slots[3];
    const e: number = this.slots[4];
    if (!distinct(this.slots)) {
      this.tip = '五个字母必须是不同数字';
      return;
    }
    if (a === 0 || c === 0 || d === 0) {
      this.tip = 'A / C / D 不能是 0';
      return;
    }
    const lhs: number = this.puz.form === 0 ? (10 * a + b) + c : (10 * a + b) * c;
    const rhs: number = 10 * d + e;
    if (lhs !== rhs) {
      this.tip = '还不成立：' + String(lhs) + ' ≠ ' + String(rhs);
      return;
    }
    this.right++;
    this.score += 10;
    this.round++;
    if (this.round >= this.diffTotal) {
      this.over = true;
      this.tip = '共解出 ' + String(this.right) + '/' + String(this.diffTotal) + TG(' 题');
      this.finish(this.right >= PASS);
      return;
    }
    this.load();
    this.sel = -1;
    this.tip = '✓ 成立！下一题：' + this.eqText();
  }

  private eqText(): string {
    const mark: string = this.puz.form === 0 ? ' + ' : ' × ';
    return 'AB' + mark + 'C = DE';
  }

  private finish(solved: boolean): void {
    const res: GameResult = {
      gameId: 'crypto_arithmetic', solved: solved, score: this.score,
      durationMs: Date.now() - this.startAt, levelReached: this.right
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(res);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('进度'), String(Math.min(this.round + 1, this.diffTotal)) + '/' + String(this.diffTotal))
        this.stat('解出', String(this.right))
        this.stat(TG('得分'), String(this.score))
      }.width('100%')

      Column({ space: Space.xs }) {
        Text(this.puz.form === 0 ? '加法式' : '乘法式').fontSize(FontSize.xs).fontColor(this.theme.inkFaint)
        Row({ space: Space.xs }) {
          this.letter(0)
          this.letter(1)
          Text(this.puz.form === 0 ? '+' : '×')
            .fontSize(FontSize.xxl).fontColor(this.theme.inkSoft).width(Space.xl).textAlign(TextAlign.Center)
          this.letter(2)
          Text('=').fontSize(FontSize.xxl).fontColor(this.theme.inkSoft).width(Space.xl).textAlign(TextAlign.Center)
          this.letter(3)
          this.letter(4)
        }
      }.width('100%').padding(Space.md).backgroundColor(this.theme.surface).borderRadius(Radius.lg).shadow(Shadow.card)

      Text(this.tip).fontSize(FontSize.sm).fontColor(this.theme.inkSoft).height(20)

      Column({ space: Space.sm }) {
        Row({ space: Space.xs }) {
          ForEach([0, 1, 2, 3, 4], (d: number) => { this.digit(d) }, (d: number) => 'p' + d)
        }.width('100%')
        Row({ space: Space.xs }) {
          ForEach([5, 6, 7, 8, 9], (d: number) => { this.digit(d) }, (d: number) => 'q' + d)
        }.width('100%')
      }.width('100%')

      Row({ space: Space.sm }) {
        Button(TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF')
          .backgroundColor(Palette.rose).borderRadius(Radius.md).width(120).height(44).onClick(() => { this.reset(); })
        Text('五个字母的数字两两不同').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      }.width('100%')
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }.layoutWeight(1).padding(Space.sm).backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  letter(k: number) {
    Stack() {
      Text(this.slots[k] < 0 ? this.letterAt(k) : String(this.slots[k])).fontSize(FontSize.xxl).fontWeight(FontWeight.Bold)
        .fontColor(this.slots[k] < 0 ? this.theme.inkFaint : (this.sel === k ? '#FFFFFF' : this.theme.ink))
    }.layoutWeight(1).aspectRatio(1).backgroundColor(this.sel === k ? Palette.violet : this.theme.surfaceAlt)
    .borderRadius(Radius.md).animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => { if (!this.over) { this.sel = k; this.tip = '给 ' + this.letterAt(k) + ' 选数字'; } })
  }

  @Builder
  digit(d: number) {
    Button(String(d)).fontSize(FontSize.lg).fontColor(this.usedDigit(d) ? this.theme.inkFaint : this.theme.ink)
      .backgroundColor(this.theme.surface).borderRadius(Radius.sm).layoutWeight(1).height(48)
      .enabled(!this.over && !this.usedDigit(d)).onClick(() => { this.tapDigit(d); })
  }
}
