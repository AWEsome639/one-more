/**
 * 双重麻烦 —— 一屏两个任务同时来：左边算算术，右边认颜色（斯特鲁普）
 *
 * 玩法：每轮要**两个都答对**才算过。算术题给 4 个数字选项；颜色题给一个"字义与颜色不符"的字
 *       （比如"红"字用绿墨水写），必须点**墨水颜色**对应的按钮（按钮上是颜色名，且用该颜色涂）
 * 胜负：撑过 8 轮 ⇒ solved=true；答错 3 次（生命用尽）⇒ solved=false
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const ROUNDS: number = 8;
const LIVES: number = 3;
const PER_CORRECT: number = 50;

const COLOR_NAMES: string[] = [TG('红'), TG('绿'), TG('蓝')];
const COLOR_VALUES: string[] = [Palette.rose, Palette.emerald, Palette.sky];

@Component
export struct GDoubleTrouble {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;
  onFinish: (r: GameResult) => void = () => {};

  @State private round: number = 1;
  // ★ 难度作用到玩法：本局「容错次数/起始量」按难度换算（简单更多 / 困难更少）
  private total: number = GameDiff.livesNow(LIVES);
  @State private lives: number = 0;
  @State private right: number = 0;          // 累计答对的小任务数
  @State private aDone: boolean = false;
  @State private bDone: boolean = false;
  @State private qText: string = '';
  @State private aAns: number = 0;
  @State private aOpts: number[] = [];
  @State private word: string = '';
  @State private ink: string = '';
  @State private bAns: string = '';
  @State private bOpts: string[] = [];
  @State private msg: string = '两个任务都做完才算过一轮';
  @State private over: boolean = false;
  @State private won: boolean = false;

  private startAt: number = 0;
  private finished: boolean = false;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  onRestart(): void {
    this.total = GameDiff.livesNow(LIVES);
    this.reset();
  }

  private reset(): void {
    this.round = 1;
    this.lives = this.total;
    this.right = 0;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.msg = '两个任务都做完才算过一轮';
    this.startAt = Date.now();
    this.newRound();
  }

  private newRound(): void {
    // ── 任务①：乘法 ──
    const a: number = 2 + Math.floor(Math.random() * 8);
    const b: number = 2 + Math.floor(Math.random() * 8);
    this.aAns = a * b;
    this.qText = a + ' × ' + b + ' = ?';
    const opts: number[] = [this.aAns];
    while (opts.length < 4) {
      const delta: number = (1 + Math.floor(Math.random() * 9)) * (Math.random() < 0.5 ? -1 : 1);
      const cand: number = this.aAns + delta;
      if (cand > 0 && opts.indexOf(cand) < 0) {
        opts.push(cand);
      }
    }
    for (let k = opts.length - 1; k > 0; k--) {
      const j: number = Math.floor(Math.random() * (k + 1));
      const t: number = opts[k];
      opts[k] = opts[j];
      opts[j] = t;
    }
    this.aOpts = opts;

    // ── 任务②：字义与颜色不符 ──
    const wi: number = Math.floor(Math.random() * COLOR_NAMES.length);
    let ii: number = Math.floor(Math.random() * COLOR_NAMES.length);
    if (ii === wi) {
      ii = (ii + 1) % COLOR_NAMES.length;
    }
    this.word = COLOR_NAMES[wi];
    this.ink = COLOR_VALUES[ii];
    this.bAns = COLOR_NAMES[ii];
    const bo: string[] = [];
    for (let i = 0; i < COLOR_NAMES.length; i++) {
      bo.push(COLOR_NAMES[i]);
    }
    this.bOpts = bo;

    this.aDone = false;
    this.bDone = false;
  }

  private pickA(v: number): void {
    if (this.over || this.aDone) {
      return;
    }
    if (v === this.aAns) {
      this.aDone = true;
      this.right++;
      this.msg = '算术对了 ✅';
      this.checkRound();
    } else {
      this.penalty('算术答错了');
    }
  }

  private pickB(name: string): void {
    if (this.over || this.bDone) {
      return;
    }
    if (name === this.bAns) {
      this.bDone = true;
      this.right++;
      this.msg = '颜色对了 ✅';
      this.checkRound();
    } else {
      this.penalty('颜色认错了（要选墨水色，不是字义）');
    }
  }

  private penalty(why: string): void {
    this.lives--;
    if (this.lives <= 0) {
      this.msg = '❌ ' + why + '，生命用尽';
      this.end(false);
      return;
    }
    this.msg = '❌ ' + why + TG('，还剩 ') + this.lives + TG(' 条命');
  }

  private checkRound(): void {
    if (this.over || !this.aDone || !this.bDone) {
      return;
    }
    if (this.round >= ROUNDS) {
      this.end(true);
      return;
    }
    this.round++;
    this.msg = TG('第 ') + this.round + ' 轮开始，两个任务都做完';
    this.newRound();
  }

  private end(solved: boolean): void {
    this.over = true;
    this.won = solved;
    this.msg = solved
      ? '🎉 撑过 ' + ROUNDS + ' 轮，答对 ' + this.right + ' 个小任务'
      : '结束：撑到第 ' + this.round + ' 轮，答对 ' + this.right + ' 个小任务';
    this.finish(solved);
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    const r: GameResult = {
      gameId: 'double_trouble',
      solved: solved,
      score: this.right * PER_CORRECT + this.lives * 30,
      durationMs: Date.now() - this.startAt,
      levelReached: this.round
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.sm }) {
      Row({ space: Space.sm }) {
        this.stat(TG('轮次'), this.round + ' / ' + ROUNDS, Palette.primary)
        this.stat(TG('生命'), this.hearts(), Palette.rose)
        this.stat(TG('答对'), String(this.right), Palette.emerald)
      }
      .width('100%')

      // 任务①：算术
      Column({ space: Space.xs }) {
        Text('任务① 算术' + (this.aDone ? ' ✅' : ''))
          .fontSize(FontSize.xs)
          .fontColor(this.theme.inkFaint)
        Text(this.qText)
          .fontSize(FontSize.xxl)
          .fontWeight(FontWeight.Bold)
          .fontColor(this.theme.ink)
        Row({ space: Space.xs }) {
          ForEach(this.aOpts, (v: number) => {
            Text(String(v))
              .fontSize(FontSize.lg)
              .fontWeight(FontWeight.Bold)
              .fontColor(this.theme.ink)
              .textAlign(TextAlign.Center)
              .layoutWeight(1)
              .height(46)
              .backgroundColor(this.theme.surfaceAlt)
              .borderRadius(Radius.md)
              .animation({ duration: Motion.fast, curve: Motion.snap() })
              .onClick(() => {
                this.pickA(v);
              })
          }, (v: number) => 'a' + v)
        }
        .width('100%')
      }
      .width('100%')
      .padding(Space.sm)
      .backgroundColor(this.theme.surface)
      .borderRadius(Radius.md)
      .shadow(Shadow.card)

      // 任务②：颜色
      Column({ space: Space.xs }) {
        Text('任务② 认颜色' + (this.bDone ? ' ✅' : '') + '（点「墨水」的颜色）')
          .fontSize(FontSize.xs)
          .fontColor(this.theme.inkFaint)
        Text(this.word)
          .fontSize(FontSize.hero)
          .fontWeight(FontWeight.Bold)
          .fontColor(this.ink)
        Row({ space: Space.xs }) {
          ForEach(this.bOpts, (n: string, i: number) => {
            Text(n)
              .fontSize(FontSize.md)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FFFFFF')
              .textAlign(TextAlign.Center)
              .layoutWeight(1)
              .height(46)
              .backgroundColor(COLOR_VALUES[i % COLOR_VALUES.length])
              .borderRadius(Radius.md)
              .animation({ duration: Motion.fast, curve: Motion.snap() })
              .onClick(() => {
                this.pickB(n);
              })
          }, (n: string) => 'b' + n)
        }
        .width('100%')
      }
      .width('100%')
      .padding(Space.sm)
      .backgroundColor(this.theme.surface)
      .borderRadius(Radius.md)
      .shadow(Shadow.card)

      Text(this.msg)
        .fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Button(TG('重开'))
        .fontSize(FontSize.md)
        .fontColor(Color.White)
        .backgroundColor(Palette.primary)
        .borderRadius(Radius.md)
        .width('100%')
        .height(46)
        .onClick(() => {
          this.reset();
        })

      Text('每轮两个任务都要答对；答错扣一条命，' + LIVES + ' 条命用完就结束，撑过 ' + ROUNDS + ' 轮通关')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  /** 生命显示：❤ = 还剩，🤍 = 已扣 */
  private hearts(): string {
    let s: string = '';
    for (let i = 0; i < LIVES; i++) {
      s += i < this.lives ? '❤' : '🤍';
    }
    return s;
  }

  @Builder
  stat(label: string, value: string, color: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(color)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }
}
