/**
 * 找不同（id: odd_one_out）—— 一格里混进了一个「另一个字符」，点出来 📐
 * 10 题，答对 ≥ 8 通关；进度：题号 / 答对 / 点错次数
 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const ROUNDS: number = 10;
const WIN: number = 8;

/** 形近字符对：[[]]普通, []异类 */
function pairs(): string[][] {
  return [
    ['●', '◉'], ['■', '▪'], ['★', '☆'], ['◆', '◇'],
    ['▲', '△'], ['▶', '▷'], ['⬤', '⬥'], ['✚', '✛'],
    ['◼', '◾'], ['❍', '◯'], ['⬟', '⬠'], ['♦', '♢']
  ];
}

@Component
export struct GOddOneOut {
  @Prop theme: Theme = Theme.light(); @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：原 ROUNDS=10
  @State private diffTotal: number = GameDiff.sizeNow(10);
  onFinish: (r: GameResult) => void = () => {};
  @State private glyphs: string[] = []; @State private odd: number = -1; @State private round: number = 1;
  @State private right: number = 0; @State private wrong: number = 0; @State private picked: number = -1;
  @State private revealed: boolean = false; @State private msg: string = '';
  @State private over: boolean = false; @State private won: boolean = false; private startAt: number = 0;
  private nextTo: number = -1; private done: boolean = false;
  aboutToAppear(): void { LanRace.noteStart(); this.startAt = Date.now(); this.reset(); }
  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(10);
     this.reset(); }
  aboutToDisappear(): void { this.clearNext(); }
  private clearNext(): void {
    if (this.nextTo >= 0) { clearTimeout(this.nextTo); this.nextTo = -1; }
  }
  private reset(): void {
    this.clearNext();
    this.round = 1;
    this.right = 0;
    this.wrong = 0;
    this.picked = -1;
    this.revealed = false;
    this.over = false;
    this.won = false;
    this.done = false;
    this.startAt = Date.now();
    this.nextRound();
  }
  private nextRound(): void {
    const p: string[][] = pairs();
    const one: string[] = p[Math.floor(Math.random() * p.length)];
    const n: number = this.round <= 3 ? 6 : (this.round <= 7 ? 9 : 12);
    const g: string[] = [];
    for (let i = 0; i < n; i++) {
      g.push(one[0]);
    }
    const oi: number = Math.floor(Math.random() * n);
    g[oi] = one[1];
    this.glyphs = g;
    this.odd = oi;
    this.picked = -1;
    this.revealed = false;
    this.msg = '有一格的字形不一样，点它 👆';
  }
  private tap(i: number): void {
    if (this.over || this.revealed) { return; }
    this.picked = i;
    this.revealed = true;
    if (i === this.odd) {
      this.right = this.right + 1;
      this.msg = '✅ 就是它 · 答对 ' + String(this.right) + '/' + String(this.diffTotal);
    } else {
      this.wrong = this.wrong + 1;
      this.msg = '❌ 点错了，异类在别处';
    }
    this.clearNext();
    this.nextTo = setTimeout(() => {
      this.nextTo = -1;
      if (this.round >= this.diffTotal) {
        this.over = true;
        this.done = true;
        this.won = this.right >= WIN;
        this.msg = (this.won ? TG('🎉 通关 ') : TG('💤 结束 ')) + TG('答对 ') + String(this.right) + '/' + String(this.diffTotal);
        this.finish();
        return;
      }
      this.round = this.round + 1;
      this.nextRound();
    }, 700);
  }
  private finish(): void {
    const r: GameResult = {
      gameId: 'odd_one_out', solved: this.won,
      score: this.right * 100 + (this.won ? 200 : 0) - this.wrong * 30,
      durationMs: Date.now() - this.startAt, levelReached: this.right
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }
  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('题号'), String(this.round) + '/' + String(this.diffTotal))
        this.stat(TG('答对'), String(this.right))
        this.stat('点错', String(this.wrong))
      }
      .width('100%')
      Column({ space: Space.sm }) {
        ForEach([0, 1, 2], (r: number) => {
          Row({ space: Space.sm }) {
            ForEach([0, 1, 2], (c: number) => {
              this.tile(r * 3 + c, r * 3 + c < this.glyphs.length)
            }, (c: number) => 'c' + c)
          }
          .width('100%')
        }, (r: number) => 'r' + r)
      }
      .width('100%')
      Text(this.msg)
        .fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)
        .width('100%')
        .textAlign(TextAlign.Center)
      Button(this.over ? TG('再来一局') : TG('重开'))
        .fontSize(FontSize.md)
        .fontColor('#FFFFFF')
        .backgroundColor(this.over && !this.won ? Palette.rose : Palette.lime)
        .borderRadius(Radius.md)
        .width('100%')
        .height(46)
        .onClick(() => { this.reset(); })
      Text('判定：10 题答对 ≥ 8 题 · 6→9→12 格逐轮变难')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
        .width('100%')
        .textAlign(TextAlign.Center)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }
  @Builder
  stat(label: string, value: string) {
    Column({ space: Space.xs }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }
  @Builder
  tile(i: number, usable: boolean) {
    Stack() {
      Text(usable ? this.glyphs[i] : '')
        .fontSize(FontSize.xxxl)
        .fontColor(this.colorOf(i))
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.bgOf(i))
    .borderRadius(Radius.md)
    .borderWidth(this.revealed && i === this.odd ? 2 : 0)
    .borderColor(Palette.emerald)
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => { this.tap(i); })
  }
  private colorOf(i: number): string {
    if (!this.revealed) {
      return this.theme.ink;
    }
    if (i === this.odd) {
      return Palette.emerald;
    }
    return this.picked === i ? Palette.rose : this.theme.inkFaint;
  }
  private bgOf(i: number): string {
    if (this.revealed && i === this.odd) {
      return this.theme.isDark ? '#0F2A22' : '#D1FAE5';
    }
    return this.theme.surface;
  }
}
