/**
 * 磁铁（Magnets）—— 4×4 / 8 组磁铁 🧲
 *
 * 棋盘被切成 8 组「横着相邻的两格」= 一块磁铁的两端。
 * 规则：每块磁铁一端是正极 ＋、另一端是负极 －（不能两端同极）；
 *       最右一列数字 = 该行正极的个数，最下一行数字 = 该列正极的个数。
 * 玩法：点格子循环切换 空 → ＋ → － → 空。
 * 胜负：8 块磁铁都成一正一负 且 行列正极数全部对上 ⇒ 通关；步数用尽 ⇒ 失败。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 4;
const CELLS: number = N * N;
/** 8 块磁铁最省也要 8×3=24 下（＋ 一下、－ 两下）⇒ 上限给足，别让手滑的人赢不了 */
const MAX_MOVES: number = 60;
const PLUS: number = 1;
const MINUS: number = 2;
const CLUE_W: number = 44;

function range(n: number): number[] {
  const a: number[] = [];
  for (let i = 0; i < n; i++) {
    a.push(i);
  }
  return a;
}

@Component
export struct GMagnets {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（lives）：MAX_MOVES 按难度换算
  @State private diffTotal: number = GameDiff.livesNow(MAX_MOVES);
  onFinish: (r: GameResult) => void = () => {};

  @State private marks: number[] = new Array<number>(CELLS).fill(0);
  @State private rowClue: number[] = new Array<number>(N).fill(0);
  @State private colClue: number[] = new Array<number>(N).fill(0);
  @State private moves: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private tip: string = '点格子切换 空 → ＋ → －';

  private startAt: number = 0;
  private finished: boolean = false;
  private rows: number[] = range(N);

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.livesNow(MAX_MOVES);
    this.reset();
  }

  /** 每块磁铁的两端下标 */
  private dominoA(r: number, d: number): number {
    return r * N + d * 2;
  }

  private reset(): void {
    const sol: number[] = new Array<number>(CELLS).fill(0);
    const rc: number[] = new Array<number>(N).fill(0);
    const cc: number[] = new Array<number>(N).fill(0);
    for (let r = 0; r < N; r++) {
      for (let d = 0; d < 2; d++) {
        const a: number = this.dominoA(r, d);
        const b: number = a + 1;
        if (Math.random() < 0.5) {
          sol[a] = PLUS;
          sol[b] = MINUS;
        } else {
          sol[a] = MINUS;
          sol[b] = PLUS;
        }
      }
    }
    for (let i = 0; i < CELLS; i++) {
      if (sol[i] === PLUS) {
        rc[Math.floor(i / N)]++;
        cc[i % N]++;
      }
    }
    this.rowClue = rc;
    this.colClue = cc;
    this.marks = new Array<number>(CELLS).fill(0);
    this.moves = 0;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.tip = '点格子切换 空 → ＋ → －';
    this.startAt = Date.now();
  }

  // ── 判定 ──

  private plusInRow(r: number): number {
    let n: number = 0;
    for (let c = 0; c < N; c++) {
      if (this.marks[r * N + c] === PLUS) {
        n++;
      }
    }
    return n;
  }

  private plusInCol(c: number): number {
    let n: number = 0;
    for (let r = 0; r < N; r++) {
      if (this.marks[r * N + c] === PLUS) {
        n++;
      }
    }
    return n;
  }

  private dominoesOk(): boolean {
    for (let r = 0; r < N; r++) {
      for (let d = 0; d < 2; d++) {
        const a: number = this.dominoA(r, d);
        const b: number = a + 1;
        const x: number = this.marks[a];
        const y: number = this.marks[b];
        if (x === 0 || y === 0 || x === y) {
          return false;
        }
      }
    }
    return true;
  }

  private linesOk(): boolean {
    for (let r = 0; r < N; r++) {
      if (this.plusInRow(r) !== this.rowClue[r]) {
        return false;
      }
    }
    for (let c = 0; c < N; c++) {
      if (this.plusInCol(c) !== this.colClue[c]) {
        return false;
      }
    }
    return true;
  }

  private placed(): number {
    let n: number = 0;
    for (let i = 0; i < CELLS; i++) {
      if (this.marks[i] !== 0) {
        n++;
      }
    }
    return n;
  }

  private goodDominoes(): number {
    let n: number = 0;
    for (let r = 0; r < N; r++) {
      for (let d = 0; d < 2; d++) {
        const a: number = this.dominoA(r, d);
        const x: number = this.marks[a];
        const y: number = this.marks[a + 1];
        if (x !== 0 && y !== 0 && x !== y) {
          n++;
        }
      }
    }
    return n;
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    const r: GameResult = {
      gameId: 'magnets',
      solved: solved,
      score: solved ? Math.max(100, 1000 - this.moves * 20) : this.goodDominoes() * 60,
      durationMs: Date.now() - this.startAt,
      levelReached: this.goodDominoes()
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  private check(): void {
    if (this.finished) {
      return;
    }
    if (this.dominoesOk() && this.linesOk()) {
      this.over = true;
      this.won = true;
      this.tip = '🎉 磁铁成对、行列正极数全对，通关！';
      this.finish(true);
      return;
    }
    if (this.moves >= this.diffTotal) {
      this.over = true;
      this.tip = TG('步数用尽，重开一题吧');
      this.finish(false);
      return;
    }
    this.tip = '磁铁成对 ' + String(this.goodDominoes()) + '/8';
  }

  private tap(i: number): void {
    if (this.over) {
      return;
    }
    const nm: number[] = this.marks.slice();
    nm[i] = (nm[i] + 1) % 3;
    this.marks = nm;
    this.moves++;
    this.check();
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.head(TG('步数'), String(this.moves) + '/' + String(this.diffTotal))
        this.head('成对磁铁', String(this.goodDominoes()) + '/8')
        this.head('已定格', String(this.placed()) + '/' + String(CELLS))
      }
      .width('100%')

      Column({ space: Space.xs }) {
        ForEach(this.rows, (r: number) => {
          Row({ space: Space.xs }) {
            ForEach(this.rows, (c: number) => {
              this.cell(r * N + c)
            }, (c: number) => 'mc' + r + '-' + c)
            this.rowClueBox(r)
          }
          .width('100%')
        }, (r: number) => 'mr' + r)

        Row({ space: Space.xs }) {
          ForEach(this.rows, (c: number) => {
            this.colClueBox(c)
          }, (c: number) => 'mq' + c)
          Row().width(CLUE_W).height(CLUE_W)
        }
        .width('100%')
      }
      .width('100%')
      .padding(Space.sm)
      .backgroundColor(this.theme.surfaceAlt)
      .borderRadius(Radius.md)

      Text(this.tip)
        .fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Text('每块磁铁（横向两格）必须一正一负；右侧/下方数字是该行该列 ＋ 的个数')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)

      Button(this.over ? (this.won ? TG('已通关 🎉') : TG('已结束')) : TG('重开一题'))
        .fontSize(FontSize.md)
        .fontColor(Color.White)
        .backgroundColor(Palette.rose)
        .borderRadius(Radius.md)
        .width('100%')
        .height(44)
        .onClick(() => {
          this.reset();
        })
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  head(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }

  @Builder
  rowClueBox(r: number) {
    Column({ space: 1 }) {
      Text(String(this.rowClue[r]) + '＋')
        .fontSize(FontSize.sm)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.plusInRow(r) === this.rowClue[r] ? Palette.emerald : this.theme.inkSoft)
      Text('现 ' + String(this.plusInRow(r)))
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width(CLUE_W)
    .height(CLUE_W)
    .justifyContent(FlexAlign.Center)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.xs)
  }

  @Builder
  colClueBox(c: number) {
    Column({ space: 1 }) {
      Text(String(this.colClue[c]) + '＋')
        .fontSize(FontSize.sm)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.plusInCol(c) === this.colClue[c] ? Palette.emerald : this.theme.inkSoft)
      Text('现 ' + String(this.plusInCol(c)))
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .justifyContent(FlexAlign.Center)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.xs)
  }

  @Builder
  cell(i: number) {
    Stack() {
      Text(this.marks[i] === PLUS ? '＋' : (this.marks[i] === MINUS ? '－' : ''))
        .fontSize(FontSize.xxl)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.marks[i] === PLUS ? Palette.rose : Palette.sky)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.marks[i] === PLUS ? '#33F43F5E' : (this.marks[i] === MINUS ? '#330EA5E9' : this.theme.surface))
    .borderRadius(Radius.sm)
    .border({ width: 1, color: this.theme.line })
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => {
      this.tap(i);
    })
  }
}
