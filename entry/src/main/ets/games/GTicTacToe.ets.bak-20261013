/**
 * 井字棋 —— 你执 ✕，电脑执 ○，三子连线者胜
 *
 * 玩法：点空格落子，电脑用极小化极大（minimax）应对，赢不了它
 * 判据：你连成三子 ⇒ 通关；电脑连成三子或平局 ⇒ 这一局没赢
 *
 * 契约：@Prop theme / @Prop @Watch('onRestart') restartToken / onFinish(r)
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { LanMatch } from '../core/LanMatch';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 3;
const CELLS: number = N * N;
const HUMAN: number = 1;
const AI: number = 2;
const TICK_MS: number = 1000;
const AI_DELAY: number = 350;
const GAP: number = 6;
const KEY_H: number = 46;

const LINES: number[][] = [
  [0, 1, 2], [3, 4, 5], [6, 7, 8],
  [0, 3, 6], [1, 4, 7], [2, 5, 8],
  [0, 4, 8], [2, 4, 6]
];

/** 谁赢了：0 无人，1 我，2 电脑 */
function winnerOf(cells: number[]): number {
  for (let i = 0; i < LINES.length; i++) {
    const L: number[] = LINES[i];
    const a: number = cells[L[0]];
    if (a !== 0 && a === cells[L[1]] && a === cells[L[2]]) {
      return a;
    }
  }
  return 0;
}

function full(cells: number[]): boolean {
  for (let i = 0; i < CELLS; i++) {
    if (cells[i] === 0) {
      return false;
    }
  }
  return true;
}

/** 局面评分：电脑赢为正、我赢为负；depth 让电脑偏爱快赢慢输 */
function score(cells: number[], turn: number, depth: number, alpha: number, beta: number): number {
  const w: number = winnerOf(cells);
  if (w === AI) {
    return 10 - depth;
  }
  if (w === HUMAN) {
    return depth - 10;
  }
  if (full(cells)) {
    return 0;
  }
  if (turn === AI) {
    let best: number = -999;
    for (let i = 0; i < CELLS; i++) {
      if (cells[i] !== 0) {
        continue;
      }
      const next: number[] = cells.slice();
      next[i] = AI;
      const s: number = score(next, HUMAN, depth + 1, alpha, beta);
      if (s > best) {
        best = s;
      }
      if (best > alpha) {
        alpha = best;
      }
      if (alpha >= beta) {
        break;                 // α-β 剪枝
      }
    }
    return best;
  }
  let worst: number = 999;
  for (let i = 0; i < CELLS; i++) {
    if (cells[i] !== 0) {
      continue;
    }
    const next: number[] = cells.slice();
    next[i] = HUMAN;
    const s: number = score(next, AI, depth + 1, alpha, beta);
    if (s < worst) {
      worst = s;
    }
    if (worst < beta) {
      beta = worst;
    }
    if (alpha >= beta) {
      break;                   // α-β 剪枝
    }
  }
  return worst;
}

function bestMove(cells: number[]): number {
  let bestS: number = -999;
  let bestI: number = -1;
  let alpha: number = -999;
  for (let i = 0; i < CELLS; i++) {
    if (cells[i] !== 0) {
      continue;
    }
    const next: number[] = cells.slice();
    next[i] = AI;
    const s: number = score(next, HUMAN, 1, alpha, 999);
    if (s > bestS) {
      bestS = s;
      bestI = i;
    }
    if (s > alpha) {
      alpha = s;
    }
  }
  return bestI;
}

@Component
export struct GTicTacToe {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法：棋盘边长（原 N=3；简单 ×0.7 / 普通 ×1 / 困难 ×1.3）
  //   ⚠️ 光改常量没用 —— 渲染原本用的是写死的 [0, 1, 2]，上面已一并改成按尺寸生成
  @State private diffTotal: number = GameDiff.sizeNow(3);

  /** 0..diffTotal-1（读 @State 建依赖，ArkUI 才追踪得到） */
  private rowIdx(): number[] {
    const n2: number = this.diffTotal > 1 ? this.diffTotal : 2;
    const a2: number[] = [];
    for (let i2 = 0; i2 < n2; i2++) { a2.push(i2); }
    return a2;
  }
  onFinish: (r: GameResult) => void = () => {};

  @State private cells: number[] = [];
  @State private winLine: number[] = [];
  @State private status: string = '';
  @State private score0: number = 0;
  @State private steps: number = 0;
  @State private seconds: number = 0;
  @State private thinking: boolean = false;
  @State private over: boolean = false;

  private startAt: number = 0;
  private timer: number = -1;
  private aiTimer: number = -1;
  private finished: boolean = false;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    // ★ 联机对局：对方的落子 = 本局「AI 的那一步」
    LanMatch.setHandler((d: string) => {
      const i: number = Number.parseInt(d, 10);
      if (isNaN(i) || this.over || this.finished || this.valAt(i) !== 0) {
        return;
      }
      const nx: number[] = this.cells.slice();
      nx[i] = AI;
      this.cells = nx;
      this.steps = this.steps + 1;
      if (!this.checkEnd()) {
        this.status = '轮到你，点一格落 ✕';
      }
    });
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(3);
    this.reset();
  }

  aboutToDisappear(): void {
    this.cleanup();
  }

  private cleanup(): void {
    if (this.timer >= 0) {
      clearInterval(this.timer);
      this.timer = -1;
    }
    if (this.aiTimer >= 0) {
      clearTimeout(this.aiTimer);
      this.aiTimer = -1;
    }
  }

  private reset(): void {
    this.cleanup();
    this.cells = new Array<number>(CELLS).fill(0);
    this.winLine = [];
    this.score0 = 0;
    this.steps = 0;
    this.seconds = 0;
    this.thinking = false;
    this.over = false;
    this.finished = false;
    this.status = '你先手，点一格落 ✕';
    this.startAt = Date.now();
    this.timer = setInterval(() => {
      if (!this.over && !this.finished) {
        this.seconds = this.seconds + 1;
      }
    }, TICK_MS);
  }

  private valAt(i: number): number {
    return i >= 0 && i < this.cells.length ? this.cells[i] : 0;
  }

  private tap(i: number): void {
    if (this.over || this.finished || this.thinking || this.valAt(i) !== 0) {
      return;
    }
    // ★ 联机时：不是我的回合就不接受点击
    if (LanMatch.isActive() && !LanMatch.myTurn()) {
      this.status = '等对手落子…';
      return;
    }
    const next: number[] = this.cells.slice();
    next[i] = HUMAN;
    this.cells = next;
    this.steps = this.steps + 1;
    // ★ 联机时：把这一步发给对方，然后**不跑 AI**（对手就是那个人）
    if (LanMatch.isActive()) {
      LanMatch.record(String(i));
      if (this.checkEnd()) {
        return;
      }
      this.status = '等对手落子…';
      return;
    }
    if (this.checkEnd()) {
      return;
    }
    this.thinking = true;
    this.status = '电脑在想…';
    this.aiTimer = setTimeout(() => {
      this.aiTimer = -1;
      this.aiTurn();
    }, AI_DELAY);
  }

  private aiTurn(): void {
    if (this.over || this.finished) {
      return;
    }
    const move: number = bestMove(this.cells);
    if (move >= 0) {
      const next: number[] = this.cells.slice();
      next[move] = AI;
      this.cells = next;
      this.steps = this.steps + 1;
    }
    this.thinking = false;
    if (!this.checkEnd()) {
      this.status = '轮到你，点一格落 ✕';
    }
  }

  /** 结算检查；返回是否已分出结果 */
  private checkEnd(): boolean {
    const w: number = winnerOf(this.cells);
    if (w !== 0) {
      const line: number[] = [];
      for (let i = 0; i < LINES.length; i++) {
        const L: number[] = LINES[i];
        if (this.cells[L[0]] === w && this.cells[L[1]] === w && this.cells[L[2]] === w) {
          line.push(L[0]);
          line.push(L[1]);
          line.push(L[2]);
        }
      }
      this.winLine = line;
      this.over = true;
      this.thinking = false;
      if (w === HUMAN) {
        this.score0 = 100;
        this.status = '🎉 三子连线，你赢了！';
        this.finish(true);
      } else {
        this.score0 = 0;
        this.status = '电脑连线了，再来一局？';
        this.finish(false);
      }
      return true;
    }
    if (full(this.cells)) {
      this.over = true;
      this.thinking = false;
      this.score0 = 40;
      this.status = '平局，谁也没连成';
      this.finish(false);
      return true;
    }
    return false;
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    this.cleanup();
    const r: GameResult = {
      gameId: 'tic_tac_toe',
      solved: solved,
      score: this.score0,
      durationMs: Date.now() - this.startAt,
      levelReached: this.steps
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.infoBox(0)
        this.infoBox(1)
        this.infoBox(2)
      }
      .width('100%')

      Column({ space: GAP }) {
        ForEach(this.rowIdx(), (r: number) => {
          Row({ space: GAP }) {
            ForEach(this.rowIdx(), (c: number) => {
              this.cellView(r * this.diffTotal + c)
            }, (c: number) => 'c' + c)
          }
          .width('100%')
        }, (r: number) => 'r' + r)
      }
      .width('82%')
      .aspectRatio(1)
      .padding(Space.sm)
      .backgroundColor('#1AEC4899')
      .borderRadius(Radius.lg)

      Text(this.status)
        .fontSize(FontSize.md)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.over ? Palette.emerald : this.theme.inkSoft)
        .width('100%')
        .textAlign(TextAlign.Center)

      Row({ space: Space.md }) {
        Button(TG('重开'))
          .fontSize(FontSize.md)
          .fontColor(Color.White)
          .backgroundColor(Palette.primary)
          .borderRadius(Radius.md)
          .layoutWeight(1)
          .height(KEY_H)
          .onClick(() => {
            this.reset();
          })
        Button('我认输')
          .fontSize(FontSize.md)
          .fontColor(this.theme.inkSoft)
          .backgroundColor(this.theme.surfaceAlt)
          .borderRadius(Radius.md)
          .layoutWeight(1)
          .height(KEY_H)
          .enabled(!this.over && !this.finished)
          .onClick(() => {
            if (!this.over && !this.finished) {
              this.over = true;
              this.status = '已认输';
              this.finish(false);
            }
          })
      }
      .width('100%')

      Text('电脑走的是最优解，最好的结果是平局')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
        .width('100%')
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  infoBox(kind: number) {
    Column({ space: 2 }) {
      Text(kind === 0 ? TG('得分') : (kind === 1 ? TG('步数') : TG('用时')))
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
      Text(kind === 0 ? String(this.score0)
        : (kind === 1 ? String(this.steps) : (this.seconds + 's')))
        .fontSize(FontSize.lg)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }

  @Builder
  cellView(i: number) {
    Stack() {
      Text(this.markOf(i))
        .fontSize(FontSize.xxxl)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.valAt(i) === HUMAN ? Palette.rose : Palette.sky)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.cellBg(i))
    .borderRadius(Radius.md)
    .scale({ x: this.inWin(i) ? 1.05 : 1, y: this.inWin(i) ? 1.05 : 1 })
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => {
      this.tap(i);
    })
  }

  private markOf(i: number): string {
    const v: number = this.valAt(i);
    return v === 0 ? '' : (v === HUMAN ? '✕' : '○');
  }

  private inWin(i: number): boolean {
    for (let k = 0; k < this.winLine.length; k++) {
      if (this.winLine[k] === i) {
        return true;
      }
    }
    return false;
  }

  private cellBg(i: number): string {
    if (this.inWin(i)) {
      return this.theme.isDark ? '#1E3A2F' : '#D1FAE5';
    }
    return this.theme.surface;
  }
}
