/**
 * 百分比巅峰 —— 限时百分比
 *
 * 玩法：45 秒内连答百分比题（求百分之几 / 求占比），四选一。
 * 胜负：答对 12 题 ⇒ 通关；时间归零还没达标 ⇒ 失败。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const TIME_LIMIT: number = 45;
const GOAL: number = 12;
const PICK: number = 4;
const NEXT_MS: number = 380;
const TICK_MS: number = 1000;

function randInt(lo: number, hi: number): number {
  return lo + Math.floor(Math.random() * (hi - lo + 1));
}

@Component
export struct GPercentagePeak {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;
  onFinish: (r: GameResult) => void = () => {};

  @State private opts: number[] = [];
  @State private ans: number = -1;
  @State private picked: number = -1;
  @State private quiz: string = '';
  @State private right: number = 0;
  @State private wrong: number = 0;
  @State private combo: number = 0;
  @State private score: number = 0;
  // ★ 难度作用到玩法：本局时限 = 基础 × 难度倍率（简单 1.5× / 普通 1× / 困难 0.7×）
  private total: number = GameDiff.timeNow(TIME_LIMIT);
  @State private left: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private msg: string = '';

  private startAt: number = 0;
  private timer: number = -1;
  private nextTo: number = -1;
  private finished: boolean = false;
  private slots: number[] = [0, 1, 2, 3];

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.startAt = Date.now();
    this.reset();
  }

  onRestart(): void {
    this.total = GameDiff.timeNow(TIME_LIMIT);   // 难度可能刚变过，必须重算
        this.reset();
  }

  aboutToDisappear(): void {
    this.clearAll();
  }

  private clearAll(): void {
    if (this.timer >= 0) {
      clearInterval(this.timer);
      this.timer = -1;
    }
    if (this.nextTo >= 0) {
      clearTimeout(this.nextTo);
      this.nextTo = -1;
    }
  }

  private reset(): void {
    this.clearAll();
    this.right = 0;
    this.wrong = 0;
    this.combo = 0;
    this.score = 0;
    this.left = this.total;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.startAt = Date.now();
    this.msg = TG('答对 ') + GOAL + ' 题通关；答错不扣时间，但断连击';
    this.ask();
    this.timer = setInterval(() => {
      if (this.over) {
        return;
      }
      this.left = this.left - 1;
      if (this.left <= 0) {
        this.left = 0;
        this.lose();
      }
    }, TICK_MS);
  }

  private ask(): void {
    const kind: number = Math.random() < 0.5 ? 0 : 1;
    let truth: number = 0;
    let q: string = '';
    if (kind === 0) {
      const p: number = 5 * randInt(2, 18);
      const v: number = 20 * randInt(2, 25);
      truth = v * p / 100;
      q = v + ' 的 ' + p + '% = ?';
    } else {
      const p: number = 5 * randInt(2, 18);
      const y: number = 20 * randInt(2, 9);
      truth = p;
      q = (y * p / 100) + ' 是 ' + y + ' 的 ?%';
    }
    const pool: number[] = [truth / 10, truth * 10, truth * 2, 100 - truth, truth + 10, truth - 10];
    const opts: number[] = [truth];
    for (let i = 0; i < pool.length && opts.length < PICK; i++) {
      const cand: number = Math.round(pool[i]);
      if (cand > 0 && opts.indexOf(cand) < 0) {
        opts.push(cand);
      }
    }
    for (let i = opts.length - 1; i > 0; i--) {
      const j: number = Math.floor(Math.random() * (i + 1));
      const tmp: number = opts[i];
      opts[i] = opts[j];
      opts[j] = tmp;
    }
    this.opts = opts;
    this.ans = opts.indexOf(truth);
    this.picked = -1;
    this.quiz = q;
  }

  private pick(i: number): void {
    if (this.picked >= 0 || this.over) {
      return;
    }
    this.picked = i;
    if (i === this.ans) {
      this.right = this.right + 1;
      this.combo = this.combo + 1;
      this.score = this.score + 80 + this.combo * 10;
      this.msg = '✅ 连击 ×' + this.combo;
    } else {
      this.wrong = this.wrong + 1;
      this.combo = 0;
      this.msg = '❌ 正确答案是 ' + this.opts[this.ans];
    }
    if (this.nextTo >= 0) {
      clearTimeout(this.nextTo);
    }
    this.nextTo = setTimeout(() => {
      this.nextTo = -1;
      this.advance();
    }, NEXT_MS);
  }

  private advance(): void {
    if (this.over) {
      return;
    }
    if (this.right >= GOAL) {
      this.msg = TG('🎉 答对 ') + GOAL + TG(' 题，通关！剩 ') + this.left + TG(' 秒');
      this.finish(true);
      return;
    }
    this.ask();
  }

  private lose(): void {
    if (this.over) {
      return;
    }
    this.msg = TG('⏰ 时间到，答对 ') + this.right + '/' + GOAL + TG(' 题');
    this.finish(false);
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    this.over = true;
    this.won = solved;
    this.clearAll();
    const r: GameResult = {
      gameId: 'percentage_peak',
      solved: solved,
      score: this.score,
      durationMs: Date.now() - this.startAt,
      levelReached: this.right
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  private optBg(i: number): string {
    if (this.picked < 0) {
      return this.theme.surface;
    }
    if (i === this.ans) {
      return Palette.lime;
    }
    return i === this.picked ? Palette.rose : this.theme.surface;
  }

  private optInk(i: number): string {
    if (this.picked < 0) {
      return this.theme.ink;
    }
    if (i === this.ans) {
      return '#FFFFFF';
    }
    return i === this.picked ? '#FFFFFF' : this.theme.inkFaint;
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('剩余'), this.left + 's')
        this.stat(TG('答对'), this.right + '/' + GOAL)
        this.stat(TG('得分'), String(this.score))
      }.width('100%')

      Stack({ alignContent: Alignment.Start }) {
        Row().width('100%').height('100%').backgroundColor(this.theme.surfaceAlt).borderRadius(Radius.full)
        Row().width(this.left * 100 / this.total + '%').height('100%').backgroundColor(this.left <= 10 ? Palette.rose : Palette.lime).borderRadius(Radius.full).animation({ duration: Motion.base, curve: Motion.snap() })
      }.width('100%').height(8)

      Column({ space: Space.xs }) {
        Text(this.quiz).fontSize(FontSize.xxl).fontWeight(FontWeight.Bold).fontColor(Palette.lime).textAlign(TextAlign.Center)
        Text('连击 ×' + this.combo + ' · 已答 ' + (this.right + this.wrong) + TG(' 题')).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      }.width('100%').padding(Space.lg).backgroundColor(this.theme.surface).borderRadius(Radius.lg).shadow(Shadow.card)

      Column({ space: Space.sm }) {
        ForEach(this.slots, (i: number) => {
          Row({ space: Space.sm }) {
            Text(String(i + 1)).fontSize(FontSize.sm).fontWeight(FontWeight.Bold).fontColor(this.theme.inkFaint)
            Text(String(this.opts[i])).fontSize(FontSize.xl).fontWeight(FontWeight.Bold).fontColor(this.optInk(i)).layoutWeight(1)
          }.width('100%').height(50).padding({ left: Space.md, right: Space.md }).backgroundColor(this.optBg(i)).borderRadius(Radius.md).shadow(Shadow.card).animation({ duration: Motion.fast, curve: Motion.snap() }).onClick(() => {
            this.pick(i);
          })
        }, (i: number) => 'pp' + i)
      }.width('100%')

      Text(this.msg).fontSize(FontSize.sm).fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft).width('100%')

      Button(this.over ? (this.won ? TG('已通关 🎉') : TG('再来一局')) : TG('重开')).fontSize(FontSize.md).fontColor(Color.White).backgroundColor(this.over && !this.won ? Palette.rose : Palette.lime).borderRadius(Radius.md).width('100%').height(46).onClick(() => {
          this.reset();
        })
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(label === TG('剩余') && this.left <= 10 ? Palette.rose : this.theme.ink)
    }.layoutWeight(1).padding(Space.sm).backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }
}
