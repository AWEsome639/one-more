/**
 * 动态凸显 —— 20 秒内点掉那个发亮的方块，它会自己换位置
 *
 * 胜负：20 秒内命中 ≥10 ⇒ 通关；点错不扣时间但计误点
 * 进度：剩余秒数 / 命中 / 误点
 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';
const SIDE: number = 4; const CELLS: number = SIDE * SIDE; const LIMIT: number = 20;      // 秒
const HOP: number = 1500;      // 目标自动换位间隔
const NEED: number = 10;
@Component
export struct GDynamicSalience {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;
  onFinish: (r: GameResult) => void = () => {};
  @State private hot: number = 0;
  @State private hits: number = 0;
  @State private miss: number = 0;
  // ★ 难度作用到玩法：本局时限 = 基础 × 难度倍率（简单 1.5× / 普通 1× / 困难 0.7×）
  private total: number = GameDiff.timeNow(LIMIT);
  @State private left: number = 0;
  @State private msg: string = '';
  @State private over: boolean = false;
  @State private won: boolean = false;
  private startAt: number = 0;
  private clock: number = -1;
  private hopper: number = -1;
  private done: boolean = false;
  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.startAt = Date.now(); this.reset();
  }
  onRestart(): void {
    this.total = GameDiff.timeNow(LIMIT);   // 难度可能刚变过，必须重算
     this.reset(); }
  aboutToDisappear(): void { this.stop(); }
  private stop(): void {
    if (this.clock >= 0) { clearInterval(this.clock); this.clock = -1; }
    if (this.hopper >= 0) { clearInterval(this.hopper); this.hopper = -1; }
  }
  private reset(): void {
    this.stop(); this.hot = Math.floor(Math.random() * CELLS); this.hits = 0; this.miss = 0;
    this.left = this.total; this.over = false; this.won = false; this.done = false; this.msg = '点亮着的方块，它会一直换位';
    this.startAt = Date.now(); this.clock = setInterval(() => { this.tick(); }, 1000);
    this.hopper = setInterval(() => { this.jump(); }, HOP);
  }
  private tick(): void {
    if (this.over) { return; }
    this.left = this.left - 1;
    if (this.left <= 0) { this.finish(); }
  }
  private jump(): void {
    if (this.over) { return; }
    let next: number = Math.floor(Math.random() * CELLS);
    while (next === this.hot) {
      next = Math.floor(Math.random() * CELLS);
    }
    this.hot = next;
  }
  private tap(i: number): void {
    if (this.over) { return; }
    if (i === this.hot) {
      this.hits = this.hits + 1; this.msg = '✅ 命中 ' + String(this.hits); this.jump();
    } else {
      this.miss = this.miss + 1; this.msg = '❌ 点偏了';
    }
  }
  private finish(): void {
    if (this.done) { return; }
    this.done = true; this.stop(); this.over = true; this.won = this.hits >= NEED;
    this.msg = (this.won ? TG('🎉 通关！') : TG('💤 本局结束：'))
      + '命中 ' + String(this.hits) + ' · 误点 ' + String(this.miss);
    const raw: number = this.hits * 100 - this.miss * 30; const r: GameResult = {
      gameId: 'dynamic_salience', solved: this.won,
      score: raw > 0 ? raw : 0, durationMs: Date.now() - this.startAt,
      levelReached: this.hits
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }
  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('剩余'), String(this.left > 0 ? this.left : 0) + 's')
        this.stat(TG('命中'), String(this.hits))
        this.stat('误点', String(this.miss))
        this.stat(TG('目标'), String(NEED))
      }.width('100%')
      Column({ space: Space.sm }) {
        ForEach([0, 1, 2, 3], (r: number) => {
          Row({ space: Space.sm }) {
            ForEach([0, 1, 2, 3], (c: number) => {
              this.cell(r * SIDE + c)
            }, (c: number) => 'sc' + c)
          }.width('100%')
        }, (r: number) => 'sr' + r)
      }.width('100%').aspectRatio(1)
      Text(this.msg).fontSize(FontSize.sm).fontColor(this.theme.inkSoft).width('100%').textAlign(TextAlign.Center)
      Button(this.over ? TG('再来一局') : TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF')
        .backgroundColor(this.over && !this.won ? Palette.rose : Palette.primary).borderRadius(Radius.md)
        .width('100%').height(46).onClick(() => { this.reset(); })
      Text('提示：它每 1.5 秒换一次位置，手快一点').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint).width('100%').textAlign(TextAlign.Center)
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }
  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.md).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }.layoutWeight(1).padding(Space.xs).backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }
  @Builder
  cell(i: number) {
    Stack() {
      Text(i === this.hot ? '🌟' : '').fontSize(FontSize.lg)
    }.layoutWeight(1).aspectRatio(1).backgroundColor(i === this.hot ? Palette.amber : this.theme.surfaceAlt)
    .borderRadius(Radius.md).scale({ x: i === this.hot ? 1.06 : 1, y: i === this.hot ? 1.06 : 1 })
    .animation({ duration: Motion.fast, curve: Motion.snap() }).onClick(() => { this.tap(i); })
  }
}
