/**
 * d2 注意 —— 划消测验：限时点出所有「带正好两个小撇的 d」
 * 胜负：30 秒内找齐 6 个目标通关，时间到判负　｜　进度：剩余 / 命中 / 点错
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const COLS: number = 8;
const CELLS: number = 32;
const TARGETS: number = 6;
const TIME_LIMIT: number = 30;
const HIT_SCORE: number = 100;
const MISS_PENALTY: number = 40;

function markStr(n: number): string {
  if (n <= 0) { return ' '; }
  return n === 1 ? '·' : '··';
}

@Component
export struct GD2Attention {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（time）：TIME_LIMIT 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.timeNow(TIME_LIMIT);
  onFinish: (r: GameResult) => void = () => {};

  @State letters: string[] = [];
  @State marks: number[] = [];
  @State isTarget: boolean[] = [];
  @State picked: boolean[] = [];
  @State hits: number = 0;
  @State wrongTap: number = 0;
  @State timeLeft: number = this.diffTotal;
  @State msg: string = '';
  @State over: boolean = false;
  @State won: boolean = false;
  private startAt: number = 0;
  private finished: boolean = false;
  private timer: number = -1;

  aboutToAppear(): void { LanRace.noteStart(); this.reset(); }
  onRestart(): void {
    this.diffTotal = GameDiff.timeNow(TIME_LIMIT);
     this.reset(); }
  aboutToDisappear(): void { this.stopTimer(); }

  private stopTimer(): void {
    if (this.timer >= 0) { clearInterval(this.timer); this.timer = -1; }
  }

  /** 造字阵：6 个「d + 2 撇」为目标，其余是带 1/3/4 撇的 d 或任意撇数的 p */
  private reset(): void {
    this.stopTimer();
    const pool: number[] = [];
    for (let i = 0; i < CELLS; i++) { pool.push(i); }
    for (let k = pool.length - 1; k > 0; k--) {
      const j: number = Math.floor(Math.random() * (k + 1));
      const tmp: number = pool[k];
      pool[k] = pool[j];
      pool[j] = tmp;
    }
    const tset: number[] = [];
    for (let i = 0; i < TARGETS; i++) { tset.push(pool[i]); }
    const ls: string[] = [];
    const ms: number[] = [];
    const ts: boolean[] = [];
    const ps: boolean[] = [];
    const opts: number[] = [1, 3, 4];
    for (let i = 0; i < CELLS; i++) {
      const isT: boolean = tset.indexOf(i) >= 0;
      if (isT) {
        ls.push('d');
        ms.push(2);
      } else {
        ls.push(Math.random() < 0.5 ? 'd' : 'p');
        ms.push(opts[Math.floor(Math.random() * opts.length)]);
      }
      ts.push(isT);
      ps.push(false);
    }
    this.letters = ls; this.marks = ms; this.isTarget = ts; this.picked = ps;
    this.hits = 0; this.wrongTap = 0; this.timeLeft = this.diffTotal;
    this.over = false; this.won = false; this.finished = false;
    this.msg = '点出「d + 正好两个小撇」';
    this.startAt = Date.now();
    this.timer = setInterval(() => { this.tick(); }, 1000);
  }

  private tick(): void {
    if (this.over) { return; }
    this.timeLeft--;
    if (this.timeLeft <= 0) { this.end(false); }
  }

  private tap(i: number): void {
    if (this.over || this.picked[i]) { return; }
    const next: boolean[] = this.picked.slice();
    next[i] = true;
    this.picked = next;
    if (this.isTarget[i]) {
      this.hits++;
      this.msg = '✅ 命中 ' + this.hits + ' / ' + TARGETS;
      if (this.hits >= TARGETS) { this.end(true); }
      return;
    }
    this.wrongTap++;
    this.msg = '❌ 那不是目标（要 d + 正好 2 撇）';
  }

  private end(solved: boolean): void {
    this.stopTimer();
    this.over = true;
    this.won = solved;
    this.msg = solved ? '🎉 全找到了！用时 ' + (this.diffTotal - this.timeLeft) + TG(' 秒')
      : '时间到：命中 ' + this.hits + ' / ' + TARGETS + '，点错 ' + this.wrongTap;
    if (this.finished) { return; }
    this.finished = true;
    const r: GameResult = {
      gameId: 'd2_attention', solved: solved,
      score: this.hits * HIT_SCORE - this.wrongTap * MISS_PENALTY,
      durationMs: Date.now() - this.startAt, levelReached: this.hits
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.sm }) {
      Row({ space: Space.sm }) {
        this.stat(TG('剩余'), this.timeLeft + TG(' 秒'), Palette.teal)
        this.stat(TG('命中'), this.hits + ' / ' + TARGETS, Palette.emerald)
        this.stat('点错', String(this.wrongTap), Palette.rose)
      }.width('100%')

      Column({ space: Space.xs }) {
        ForEach([0, 1, 2, 3], (r: number) => {
          Row({ space: Space.xs }) {
            ForEach([0, 1, 2, 3, 4, 5, 6, 7], (c: number) => {
              this.cellView(r * COLS + c)
            }, (c: number) => 'c' + c)
          }.width('100%')
        }, (r: number) => 'r' + r)
      }.width('100%').padding(Space.sm)
        .backgroundColor(this.theme.surfaceAlt).borderRadius(Radius.lg)

      Text(this.msg).fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Button(TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF').backgroundColor(Palette.primary)
        .borderRadius(Radius.md).width('100%').height(46).onClick(() => { this.reset(); })

      Text('目标＝字母 d 且上下小撇共 2 个；' + this.diffTotal + ' 秒内找齐 ' + TARGETS + TG(' 个'))
        .fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string, color: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(color)
    }.layoutWeight(1).padding(Space.sm).backgroundColor(this.theme.surface)
      .borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  cellView(i: number) {
    Column({ space: 0 }) {
      Text(markStr(Math.min(this.marks[i], 2))).fontSize(FontSize.xxs).fontColor(this.theme.inkSoft)
      Text(this.letters[i]).fontSize(FontSize.md).fontWeight(FontWeight.Bold)
        .fontColor(this.picked[i] ? (this.isTarget[i] ? Palette.emerald : Palette.rose) : this.theme.ink)
      Text(markStr(this.marks[i] - Math.min(this.marks[i], 2)))
        .fontSize(FontSize.xxs).fontColor(this.theme.inkSoft)
    }.layoutWeight(1).height(46).justifyContent(FlexAlign.Center)
      .backgroundColor(this.picked[i] ? this.theme.surfaceAlt : this.theme.surface)
      .borderRadius(Radius.xs)
      .animation({ duration: Motion.fast, curve: Motion.snap() })
      .onClick(() => { this.tap(i); })
  }
}
