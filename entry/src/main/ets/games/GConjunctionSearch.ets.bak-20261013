/**
 * 联合特征 —— 颜色 × 形状的联合搜索
 * 胜负：连过 6 关通关，点错 3 次判负　｜　进度：关卡 / 错误 / 得分
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const SIZE: number = 5;
const CELLS: number = 25;
const ROUNDS: number = 6;
const MAX_WRONG: number = 3;
const KIND_SQUARE: number = 0;   // 红方块（干扰）
const KIND_CIRCLE: number = 1;   // 蓝圆点（干扰）
const KIND_TARGET: number = 2;   // 红圆点（目标）

function kindColor(k: number): string {
  return k === KIND_CIRCLE ? '#0EA5E9' : '#EF4444';
}

function kindGlyph(k: number): string {
  return k === KIND_CIRCLE ? '●' : '■';
}

@Component
export struct GConjunctionSearch {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：ROUNDS 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.sizeNow(ROUNDS);
  onFinish: (r: GameResult) => void = () => {};

  @State cells: number[] = [];
  @State round: number = 1;
  @State wrong: number = 0;
  @State flashIdx: number = -1;
  @State msg: string = '';
  @State over: boolean = false;
  @State won: boolean = false;
  private startAt: number = 0;
  private finished: boolean = false;

  aboutToAppear(): void { LanRace.noteStart(); this.reset(); }
  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(ROUNDS);
     this.reset(); }

  private reset(): void {
    this.round = 1; this.wrong = 0; this.flashIdx = -1;
    this.over = false; this.won = false; this.finished = false;
    this.msg = '点出唯一的「红圆点」';
    this.startAt = Date.now();
    this.newBoard();
  }

  private newBoard(): void {
    const next: number[] = [];
    for (let i = 0; i < CELLS; i++) { next.push(i % 2 === 0 ? KIND_SQUARE : KIND_CIRCLE); }
    for (let k = CELLS - 1; k > 0; k--) {
      const j: number = Math.floor(Math.random() * (k + 1));
      const tmp: number = next[k];
      next[k] = next[j];
      next[j] = tmp;
    }
    next[Math.floor(Math.random() * CELLS)] = KIND_TARGET;
    this.cells = next;
    this.flashIdx = -1;
  }

  private tap(i: number): void {
    if (this.over || i < 0 || i >= CELLS) { return; }
    const k: number = this.cells[i];
    if (k === KIND_TARGET) {
      this.flashIdx = i;
      if (this.round >= this.diffTotal) { this.end(true); return; }
      this.round++;
      this.msg = '✅ 找到！进入第 ' + this.round + ' / ' + this.diffTotal + TG(' 关');
      this.newBoard();
      return;
    }
    this.wrong++;
    this.msg = '❌ 那是' + (k === KIND_CIRCLE ? '蓝圆点' : '红方块');
    if (this.wrong >= MAX_WRONG) { this.end(false); }
  }

  private end(solved: boolean): void {
    this.over = true;
    this.won = solved;
    this.msg = solved ? '🎉 ' + this.diffTotal + ' 关全清，眼力满分'
      : '错 ' + this.wrong + ' 次，本局结束';
    if (this.finished) { return; }
    this.finished = true;
    const r: GameResult = {
      gameId: 'conjunction_search', solved: solved, score: this.round * 100 - this.wrong * 40,
      durationMs: Date.now() - this.startAt, levelReached: this.round
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('关卡'), this.round + ' / ' + this.diffTotal, Palette.primaryDeep)
        this.stat(TG('错误'), this.wrong + ' / ' + MAX_WRONG, Palette.rose)
        this.stat(TG('得分'), String(this.round * 100 - this.wrong * 40), Palette.amber)
      }.width('100%')

      Column({ space: Space.xs }) {
        ForEach([0, 1, 2, 3, 4], (r: number) => {
          Row({ space: Space.xs }) {
            ForEach([0, 1, 2, 3, 4], (c: number) => {
              this.cellView(r * SIZE + c)
            }, (c: number) => 'c' + c)
          }.width('100%')
        }, (r: number) => 'r' + r)
      }.width('100%').aspectRatio(1).padding(Space.sm)
        .backgroundColor(this.theme.surfaceAlt).borderRadius(Radius.lg)

      Text(this.msg).fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Button(TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF').backgroundColor(Palette.primary)
        .borderRadius(Radius.md).width('100%').height(46).onClick(() => { this.reset(); })

      Text('目标＝红色 □ 与蓝色 ● 的联合：唯一的红 ●')
        .fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string, color: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(color)
    }.layoutWeight(1).padding(Space.sm).backgroundColor(this.theme.surface)
      .borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  cellView(i: number) {
    Stack() {
      Text(kindGlyph(this.cells[i])).fontSize(FontSize.xxl).fontColor(kindColor(this.cells[i]))
    }.layoutWeight(1).aspectRatio(1)
      .backgroundColor(this.flashIdx === i ? Palette.amber : this.theme.surface)
      .borderRadius(Radius.sm)
      .animation({ duration: Motion.fast, curve: Motion.snap() })
      .onClick(() => { this.tap(i); })
  }
}
