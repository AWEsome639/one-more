/**
 * 尼姆博弈（反着玩）—— 拿走最后一颗就输 🎲
 *
 * 规则：三堆石子（3 / 5 / 7）。轮流从任意一堆拿走任意多颗，
 *      谁拿走最后一颗谁就输。点第 k 颗石子 = 从这一堆拿走 k 颗。
 * 胜负：让 AI 拿走最后一颗 = 通关；自己拿了最后一颗 = 失败
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { LanMatch } from '../core/LanMatch';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

@Component
export struct GNim {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  /** 按难度给出初始堆 */
  private static startPiles(): number[] {
    const d: number = GameDiff.now();
    if (d === 0) { return [2, 3, 4]; }
    if (d === 2) { return [4, 7, 10]; }
    return [3, 5, 7];
  }
  onFinish: (r: GameResult) => void = () => {};

  // ★ 难度作用到玩法：每堆的豆子数（简单 [2,3,4] / 普通 [3,5,7] / 困难 [4,7,10]）
  @State private piles: number[] = GNim.startPiles();
  @State private turn: number = 0;      // 0 = 你，1 = AI
  @State private moves: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private msg: string = '点某堆的第 k 颗石子 = 从这堆拿走 k 颗';

  private aiTimer: number = -1;
  private startAt: number = 0;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    // ★ 联机对局：对方走 AI 那一方 —— 收到「堆:颗数」就当成 AI 的那一步应用
    LanMatch.setHandler((d: string) => {
      const p: string[] = d.split(':');
      if (p.length < 2) {
        return;
      }
      const i: number = Number.parseInt(p[0], 10);
      const t: number = Number.parseInt(p[1], 10);
      if (isNaN(i) || isNaN(t) || this.over || t > this.piles[i]) {
        return;
      }
      const n: number[] = this.piles.slice();
      n[i] = n[i] - t;
      this.piles = n;
      this.moves = this.moves + 1;
      this.turn = 0;
      if (this.total(n) === 0) {
        this.over = true;
        this.won = true;          // 对手拿了最后一颗 ⇒ 我赢
        this.msg = '对手拿走了最后一颗…这局你赢了';
        this.finish(true);
        return;
      }
      this.msg = '轮到你拿';
    });
    this.reset();
  }

  aboutToDisappear(): void {
    this.clearAi();
  }

  onRestart(): void {
    this.piles = GNim.startPiles();
    this.reset();
  }

  private clearAi(): void {
    if (this.aiTimer !== -1) {
      clearTimeout(this.aiTimer);
      this.aiTimer = -1;
    }
  }

  private reset(): void {
    this.clearAi();
    this.piles = [3, 5, 7];
    this.turn = 0;
    this.moves = 0;
    this.over = false;
    this.won = false;
    this.msg = '点某堆的第 k 颗石子 = 从这堆拿走 k 颗';
    this.startAt = Date.now();
  }

  private total(p: number[]): number {
    let s: number = 0;
    for (let i = 0; i < p.length; i++) {
      s += p[i];
    }
    return s;
  }

  private stones(n: number): string {
    let s: string = '';
    for (let i = 0; i < n; i++) {
      s += '●';
    }
    return s;
  }

  /** 反尼姆：把「留给对手的局面」判成必败局 */
  private losingFor(h: number[]): boolean {
    let big: number = 0;
    let ones: number = 0;
    let x: number = 0;
    for (let i = 0; i < h.length; i++) {
      if (h[i] > 1) {
        big++;
      }
      if (h[i] === 1) {
        ones++;
      }
      x = x ^ h[i];
    }
    if (big === 0) {
      return ones % 2 === 1;
    }
    return x === 0;
  }

  /** 暴力找一步最优：拿完后对手必败 */
  private aiPick(): number[] {
    for (let i = 0; i < this.piles.length; i++) {
      for (let t = 1; t <= this.piles[i]; t++) {
        const n: number[] = this.piles.slice();
        n[i] = n[i] - t;
        if (this.total(n) === 0) {
          continue;   // 拿最后一颗 = 自己输
        }
        if (this.losingFor(n)) {
          const out: number[] = [i, t];
          return out;
        }
      }
    }
    let big: number = 0;
    for (let i = 0; i < this.piles.length; i++) {
      if (this.piles[i] > this.piles[big]) {
        big = i;
      }
    }
    const out2: number[] = [big, 1];
    return out2;
  }

  private take(i: number, t: number): void {
    if (this.over || this.turn !== 0 || t > this.piles[i]) {
      return;
    }
    // ★ 联机时：不是我的回合就不接受操作
    if (LanMatch.isActive() && !LanMatch.myTurn()) {
      this.msg = '等对手拿…';
      return;
    }
    const n: number[] = this.piles.slice();
    n[i] = n[i] - t;
    this.piles = n;
    this.moves = this.moves + 1;
    // ★ 联机时：把「哪一堆、拿几颗」发给对方，然后**不跑 AI**
    if (LanMatch.isActive()) {
      LanMatch.record(String(i) + ':' + String(t));
      if (this.total(n) === 0) {
        this.over = true;
        this.won = false;
        this.msg = '你拿走了最后一颗…按规矩这局你输了';
        this.finish(false);
        return;
      }
      this.msg = '等对手拿…';
      return;
    }
    if (this.total(n) === 0) {
      this.over = true;
      this.won = false;
      this.msg = '你拿走了最后一颗…按规矩这局你输了';
      this.finish(false);
      return;
    }
    this.turn = 1;
    this.msg = 'AI 正在想…';
    this.clearAi();
    this.aiTimer = setTimeout(() => {
      this.aiTimer = -1;
      this.aiTurn();
    }, 650);
  }

  private aiTurn(): void {
    if (this.over || this.turn !== 1) {
      return;
    }
    const pick: number[] = this.aiPick();
    const n: number[] = this.piles.slice();
    n[pick[0]] = n[pick[0]] - pick[1];
    this.piles = n;
    if (this.total(n) === 0) {
      this.over = true;
      this.won = true;
      this.msg = 'AI 拿走了最后一颗，你赢了！';
      this.finish(true);
      return;
    }
    this.turn = 0;
    this.msg = 'AI 从第 ' + String(pick[0] + 1) + ' 堆拿走 ' + String(pick[1]) + ' 颗，轮到你了';
  }

  private finish(solved: boolean): void {
    const r: GameResult = {
      gameId: 'nim',
      solved: solved,
      score: solved ? Math.max(100, 1000 - this.moves * 30) : 0,
      durationMs: Date.now() - this.startAt,
      levelReached: this.moves
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.md }) {
        this.head('剩余石子', String(this.total(this.piles)))
        this.head('你的步数', String(this.moves))
        this.head('轮到', this.over ? '—' : (this.turn === 0 ? '你' : 'AI'))
      }
      .width('100%')

      ForEach([0, 1, 2], (i: number) => {
        this.pileRow(i)
      }, (i: number) => 'pile' + i)

      Text(this.over ? this.msg : (this.turn === 0 ? this.msg : 'AI 思考中…'))
        .fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)
        .textAlign(TextAlign.Center)
        .width('100%')

      Button(TG('重开'))
        .fontSize(FontSize.md).fontColor(Color.White)
        .backgroundColor(Palette.emerald).borderRadius(Radius.md)
        .width('100%').height(44)
        .onClick(() => {
          this.reset();
        })

      Text('小提示：三堆都只剩 1 颗时，谁先动手谁输')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  head(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }
    .layoutWeight(1).padding(Space.sm)
    .backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  pileRow(i: number) {
    Column({ space: Space.xs }) {
      Row() {
        Text(TG('第 ') + String(i + 1) + ' 堆').fontSize(FontSize.xs).fontColor(this.theme.inkFaint)
        Text(this.stones(this.piles[i]))
          .fontSize(FontSize.md)
          .fontColor(this.piles[i] > 0 ? Palette.emerald : this.theme.lineSoft)
          .layoutWeight(1)
          .textAlign(TextAlign.End)
      }
      .width('100%')

      Row({ space: Space.xs }) {
        ForEach([1, 2, 3, 4, 5, 6, 7], (k: number) => {
          if (k <= this.piles[i]) {
            Text(String(k))
              .fontSize(FontSize.xs)
              .fontColor(this.theme.ink)
              .textAlign(TextAlign.Center)
              .layoutWeight(1)
              .height(40)
              .backgroundColor(this.turn === 0 && !this.over ? '#1A10B981' : this.theme.surfaceAlt)
              .borderRadius(Radius.sm)
              .border({ width: 1, color: this.theme.line })
              .onClick(() => {
                this.take(i, k);
              })
          }
        }, (k: number) => 'p' + i + '-' + k)
      }
      .width('100%')
    }
    .width('100%')
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }
}
