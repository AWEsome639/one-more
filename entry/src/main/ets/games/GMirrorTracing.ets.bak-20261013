/**
 * 镜像描线（id: mirror_tracing）—— 你在一面镜子上描：点左边，画到右边 🪞
 * 胜负：3 关全部画完 ⇒ 通关；笔数耗尽 ⇒ 失败（可以「擦掉」反悔）
 * 进度：第几关 / 点中格数 / 剩余笔数
 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 4;
const CELLS: number = N * N;
const LEVELS: number = 3;
const BUDGET: number = 8;

/** 镜像坐标：左右对调（其余坐标不变） */
function mIdx(i: number): number {
  const r: number = Math.floor(i / N);
  const c: number = i % N;
  return r * N + (N - 1 - c);
}

@Component
export struct GMirrorTracing {
  @Prop theme: Theme = Theme.light(); @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：原 LEVELS=3
  @State private diffTotal: number = GameDiff.sizeNow(3);
  onFinish: (r: GameResult) => void = () => {};
  @State private target: boolean[] = []; @State private mark: boolean[] = []; @State private taps: number = 0;
  @State private level: number = 1; @State private msg: string = ''; @State private over: boolean = false;
  @State private won: boolean = false; private startAt: number = 0; private done: boolean = false;
  aboutToAppear(): void { LanRace.noteStart(); this.startAt = Date.now(); this.reset(); }
  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(3);
     this.reset(); }
  private reset(): void {
    this.level = 1;
    this.taps = 0;
    this.over = false;
    this.won = false;
    this.done = false;
    this.startAt = Date.now();
    this.makeLevel();
  }
  /** 每关的图案：贴在镜面上的折线，逐关变长 */
  private makeLevel(): void {
    const t: boolean[] = new Array<boolean>(CELLS).fill(false);
    t[N - 1] = true;
    t[N - 2] = true;
    t[N - 3] = true;
    t[2 * N - 3] = true;
    if (this.level >= 2) {
      t[3 * N - 3] = true;
    }
    if (this.level >= 3) {
      t[3 * N - 4] = true;
    }
    this.target = t;
    this.mark = new Array<boolean>(CELLS).fill(false);
    this.taps = 0;
    this.msg = '点镜子左边，笔会落在右边的对称位置';
  }
  private tap(i: number): void {
    if (this.over || this.done) { return; }
    const j: number = mIdx(i);
    if (this.mark[j]) {
      this.mark[j] = false;
      this.taps = this.taps + 1;
      this.msg = '🧽 擦掉了一格（也算一笔）';
      return;
    }
    if (this.taps >= BUDGET) {
      this.failLevel();
      return;
    }
    this.mark[j] = true;
    this.taps = this.taps + 1;
    if (this.hitMismatch()) {
      this.msg = '✏️ 画歪了，可以点同一格擦掉';
    } else {
      this.msg = '✏️ 对齐了 ' + String(this.hitN()) + '/' + String(this.targetN()) + TG(' 格');
    }
    if (this.allHit() && this.taps <= BUDGET) {
      if (this.level >= this.diffTotal) {
        this.done = true;
        this.over = true;
        this.won = true;
        this.msg = '🎉 三关都画成了 · 共 ' + String(this.taps) + ' 笔';
        this.finish(true);
      } else {
        this.level = this.level + 1;
        this.msg = '✅ 这一关成了，下一关 👉';
        this.makeLevel();
      }
      return;
    }
    if (this.taps >= BUDGET) {
      this.failLevel();
    }
  }
  private hitN(): number {
    let n: number = 0;
    for (let i = 0; i < CELLS; i++) {
      if (this.mark[i] && this.target[i]) {
        n++;
      }
    }
    return n;
  }
  private targetN(): number {
    let n: number = 0;
    for (let i = 0; i < CELLS; i++) {
      if (this.target[i]) {
        n++;
      }
    }
    return n;
  }
  private allHit(): boolean {
    for (let i = 0; i < CELLS; i++) {
      if (this.mark[i] !== this.target[i]) {
        return false;
      }
    }
    return true;
  }
  private hitMismatch(): boolean {
    for (let i = 0; i < CELLS; i++) {
      if (this.mark[i] && !this.target[i]) {
        return true;
      }
    }
    return false;
  }
  private failLevel(): void {
    this.done = true;
    this.over = true;
    this.won = false;
    this.msg = '💤 笔用完了，这一关没描成';
    this.finish(false);
  }
  private finish(solved: boolean): void {
    const r: GameResult = {
      gameId: 'mirror_tracing', solved: solved,
      score: solved ? Math.max(150, 300 * this.diffTotal - (BUDGET * this.diffTotal - this.taps) * 10) : (this.level - 1) * 120,
      durationMs: Date.now() - this.startAt, levelReached: this.level
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }
  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('关卡'), String(this.level) + '/' + String(this.diffTotal))
        this.stat('对齐', String(this.hitN()) + '/' + String(this.targetN()))
        this.stat('剩余笔', String(Math.max(0, BUDGET - this.taps)))
      }
      .width('100%')
      Text('🎯 目标图案（在镜子里）')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
        .width('100%')
      this.grid(true, false)
      Text('✏️ 你描的（画布是镜子，左右反着落笔）')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
        .width('100%')
      this.grid(false, true)
      Text(this.msg)
        .fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)
        .width('100%')
        .textAlign(TextAlign.Center)
      Button(this.over ? TG('再来一局') : TG('重开'))
        .fontSize(FontSize.md)
        .fontColor('#FFFFFF')
        .backgroundColor(this.over && !this.won ? Palette.rose : Palette.violet)
        .borderRadius(Radius.md)
        .width('100%')
        .height(46)
        .onClick(() => { this.reset(); })
      Text('判定：3 关全部对齐通关 · 每关 8 笔（擦掉也算一笔）')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
        .width('100%')
        .textAlign(TextAlign.Center)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }
  @Builder
  stat(label: string, value: string) {
    Column({ space: Space.xs }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }
  @Builder
  grid(isTarget: boolean, clickable: boolean) {
    Column({ space: 2 }) {
      ForEach([0, 1, 2, 3], (r: number) => {
        Row({ space: 2 }) {
          ForEach([0, 1, 2, 3], (c: number) => {
            this.cell(r * N + c, isTarget, clickable)
          }, (c: number) => 'c' + c)
        }
        .width('100%')
      }, (r: number) => 'r' + r)
    }
    .width('72%')
    .aspectRatio(1)
    .padding(Space.xs)
    .backgroundColor(this.theme.surfaceAlt)
    .borderRadius(Radius.md)
  }
  @Builder
  cell(i: number, isTarget: boolean, clickable: boolean) {
    Stack() {
      Text(isTarget ? (this.target[i] ? '●' : '')
        : (this.mark[i] ? '●' : String(i + 1))) .fontSize(FontSize.xxs)
        .fontColor(isTarget ? Palette.violet : (this.mark[i] ? Palette.teal : this.theme.inkFaint))
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.cellBg(i, isTarget))
    .borderRadius(Radius.xs)
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => {
      if (clickable) {
        this.tap(i);
      }
    })
  }
  private cellBg(i: number, isTarget: boolean): string {
    if (isTarget) {
      return this.target[i] ? '#E9E3FE' : (this.theme.isDark ? '#1E1E1E' : '#FFFFFF');
    }
    if (this.mark[i]) {
      return this.target[i] ? '#CCFBF1' : '#FEE2E2';
    }
    return this.theme.isDark ? '#1E1E1E' : '#FFFFFF';
  }
}
