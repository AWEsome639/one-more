/**
 * 字母划消 —— 在字母盘里划掉指定字母：漏点会扣剩余时间，点错直接罚 3 秒
 * 胜负：划满 3 盘通关｜进度：盘数 / 已划 / 剩余秒数
 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 6; const CELLS: number = N * N;
const TARGETS: number = 8; const PLATES: number = 3;
const LIMIT_S: number = 40; const TICK_MS: number = 500;
const ALL: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

@Component
export struct GLetterCancellation {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（time）：LIMIT_S 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.timeNow(LIMIT_S);
  onFinish: (r: GameResult) => void = () => {};

  @State g: string[] = []; @State target: string = 'A'; @State hit: number[] = [];
  @State plate: number = 0; @State need: number = TARGETS; @State wrong: number = 0;
  @State score: number = 0; @State leftS: number = this.diffTotal; @State msg: string = '';
  @State over: boolean = false; @State won: boolean = false;
  private startAt: number = 0; private timer: number = -1; private done: boolean = false;

  aboutToAppear(): void { LanRace.noteStart(); this.startAt = Date.now(); this.reset(); }
  onRestart(): void {
    this.diffTotal = GameDiff.timeNow(LIMIT_S);
     this.reset(); }
  aboutToDisappear(): void { this.stop(); }
  private stop(): void { if (this.timer >= 0) { clearInterval(this.timer); this.timer = -1; } }
  private reset(): void {
    this.stop();
    this.plate = 0; this.wrong = 0; this.score = 0; this.leftS = this.diffTotal;
    this.over = false; this.won = false; this.done = false;
    this.msg = '划掉盘里所有的目标字母';
    this.startAt = Date.now();
    this.load();
    this.timer = setInterval(() => { this.tick(); }, TICK_MS);
  }
  private load(): void {
    this.target = ALL[Math.floor(Math.random() * ALL.length)];
    const grid: string[] = [];
    for (let i = 0; i < CELLS; i++) {
      grid.push(ALL[Math.floor(Math.random() * ALL.length)]);
    }
    const slots: number[] = [];
    for (let i = 0; i < CELLS; i++) { slots.push(i); }
    for (let i = slots.length - 1; i > 0; i--) {
      const j: number = Math.floor(Math.random() * (i + 1));
      const t: number = slots[i]; slots[i] = slots[j]; slots[j] = t;
    }
    for (let k = 0; k < TARGETS; k++) {
      grid[slots[k]] = this.target;
    }
    let cnt: number = 0;
    for (let i = 0; i < grid.length; i++) {
      if (grid[i] === this.target) { cnt = cnt + 1; }
    }
    this.need = cnt;
    this.g = grid;
    this.hit = [];
  }
  private tick(): void {
    if (this.over) { return; }
    this.leftS = this.leftS - 0.5;
    if (this.leftS <= 0) {
      this.leftS = 0; this.over = true; this.won = false;
      this.msg = '⌛ 时间到 —— 划完 ' + this.plate + ' / ' + PLATES + ' 盘'; this.finish(false);
    }
  }
  private tap(i: number): void {
    if (this.over || this.hit.indexOf(i) >= 0) { return; }
    if (this.g[i] !== this.target) {
      this.wrong = this.wrong + 1;
      this.leftS = this.leftS - 3;
      this.msg = '❌ 这不是「' + this.target + '」，罚 3 秒';
      if (this.leftS <= 0) {
        this.leftS = 0; this.over = true; this.won = false;
        this.finish(false);
      }
      return;
    }
    this.hit = this.hit.concat([i]);
    this.score = this.score + 30;
    if (this.hit.length >= this.need) {
      this.plate = this.plate + 1;
      if (this.plate >= PLATES) {
        this.over = true; this.won = true;
        this.score = this.score + Math.floor(this.leftS) * 20;
        this.msg = '🎉 通关：划完 ' + PLATES + ' 盘'; this.finish(true);
        return;
      }
      this.load();
      this.msg = TG('✅ 第 ') + this.plate + ' 盘清空，下一盘！';
      return;
    }
    this.msg = '✅ 还剩 ' + (this.need - this.hit.length) + ' 个「' + this.target + '」';
  }
  private finish(solved: boolean): void {
    if (this.done) { return; }
    this.done = true;
    const r: GameResult = { gameId: 'letter_cancellation', solved: solved, score: this.score,
      durationMs: Date.now() - this.startAt, levelReached: this.plate };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat('盘数', this.plate + ' / ' + PLATES, Palette.berry)
        this.stat('已划', this.hit.length + ' / ' + this.need, Palette.emerald)
        this.stat('点错', String(this.wrong), Palette.rose)
        this.stat(TG('剩余'), Math.ceil(this.leftS) + 's', Palette.amber)
      }.width('100%')

      Row({ space: Space.sm }) {
        Text(TG('目标')).fontSize(FontSize.sm).fontColor(this.theme.inkFaint)
        Text(this.target).fontSize(FontSize.xxxl).fontWeight(FontWeight.Bold).fontColor(Palette.berry)
        Text('盘里共 ' + this.need + TG(' 个')).fontSize(FontSize.xs).fontColor(this.theme.inkFaint)
      }.width('100%').justifyContent(FlexAlign.Center)

      Column({ space: Space.xs }) {
        ForEach([0, 1, 2, 3, 4, 5], (r: number) => {
          Row({ space: Space.xs }) {
            ForEach([0, 1, 2, 3, 4, 5], (c: number) => {
              this.cell(r * N + c)
            }, (c: number) => 'c' + c)
          }.width('100%')
        }, (r: number) => 'r' + r)
      }.width('100%')

      Text(this.msg).fontSize(FontSize.sm).fontWeight(FontWeight.Bold).width('100%').textAlign(TextAlign.Center).fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Button(TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF').backgroundColor(Palette.primary).borderRadius(Radius.md).width('100%').height(46).onClick(() => { this.reset(); })

      Text('划满 ' + PLATES + ' 盘通关；漏一个罚 3 秒，点错也罚 3 秒').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint).width('100%').textAlign(TextAlign.Center)
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string, tone: string) {
    Column({ space: Space.xs }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.md).fontWeight(FontWeight.Bold).fontColor(tone)
    }.layoutWeight(1).padding(Space.xs).backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  cell(i: number) {
    Text(this.g.length > i ? this.g[i] : '').fontSize(FontSize.md).fontWeight(FontWeight.Bold).textAlign(TextAlign.Center).fontColor(this.hit.indexOf(i) >= 0 ? '#FFFFFF' : this.theme.ink).layoutWeight(1).aspectRatio(1).backgroundColor(this.hit.indexOf(i) >= 0 ? Palette.berry : this.theme.surface).borderRadius(Radius.sm).shadow(Shadow.card).animation({ duration: Motion.fast, curve: Motion.snap() }).onClick(() => { this.tap(i); })
  }
}
