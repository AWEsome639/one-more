/**
 * 模路径 —— 按模数走格
 *
 * 玩法：5×5 格子里有一条隐形的路，起点已给出；每次只能走到上下左右相邻、
 *       且数值恰好 +1（满 8 归 0）的格子，把整条路走出来。
 * 胜负：走满 6 格 ⇒ 通关；踩错 3 次 ⇒ 失败。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const GRID: number = 5;
const PATH_LEN: number = 6;
const MOD: number = 8;
const LIVES: number = 3;

function randInt(lo: number, hi: number): number {
  return lo + Math.floor(Math.random() * (hi - lo + 1));
}

@Component
export struct GModuloPath {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（lives）：LIVES 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.livesNow(LIVES);
  onFinish: (r: GameResult) => void = () => {};

  @State private vals: number[] = [];
  @State private trail: number[] = [];
  @State private pos: number = -1;
  @State private startVal: number = 0;
  @State private step: number = 0;
  @State private err: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private msg: string = '';

  private startAt: number = 0;
  private finished: boolean = false;
  private cellsIdx: number[] = [];

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    const a: number[] = [];
    for (let i = 0; i < GRID * GRID; i++) {
      a.push(i);
    }
    this.cellsIdx = a;
    this.startAt = Date.now();
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.livesNow(LIVES);
    this.reset();
  }

  private reset(): void {
    const board: number[] = new Array<number>(GRID * GRID).fill(0);
    let path: number[] = [];
    for (let tries = 0; tries < 80 && path.length < PATH_LEN; tries++) {
      const seen: boolean[] = new Array<boolean>(GRID * GRID).fill(false);
      const walk: number[] = [randInt(0, GRID * GRID - 1)];
      seen[walk[0]] = true;
      while (walk.length < PATH_LEN) {
        const cur: number = walk[walk.length - 1];
        const r: number = Math.floor(cur / GRID);
        const c: number = cur % GRID;
        const nb: number[] = [];
        if (r > 0 && !seen[cur - GRID]) {
          nb.push(cur - GRID);
        }
        if (r < GRID - 1 && !seen[cur + GRID]) {
          nb.push(cur + GRID);
        }
        if (c > 0 && !seen[cur - 1]) {
          nb.push(cur - 1);
        }
        if (c < GRID - 1 && !seen[cur + 1]) {
          nb.push(cur + 1);
        }
        if (nb.length === 0) {
          break;
        }
        const nxt: number = nb[Math.floor(Math.random() * nb.length)];
        seen[nxt] = true;
        walk.push(nxt);
      }
      if (walk.length >= PATH_LEN) {
        path = walk.slice(0, PATH_LEN);
      }
    }
    if (path.length < PATH_LEN) {
      path = [0, 1, 2, 3, 4, 5];   // 兜底：第一行直线
    }
    const base: number = randInt(0, MOD - 1);
    for (let i = 0; i < path.length; i++) {
      board[path[i]] = (base + i) % MOD;
    }
    // 干扰格只用「路外余数」，保证每个数值唯一对应一格
    const spare: number[] = [];
    for (let r = 0; r < MOD; r++) {
      let used: boolean = false;
      for (let i = 0; i < path.length; i++) {
        if ((base + i) % MOD === r) {
          used = true;
        }
      }
      if (!used) {
        spare.push(r);
      }
    }
    for (let i = 0; i < board.length; i++) {
      if (path.indexOf(i) < 0) {
        const rr: number = spare.length > 0 ? spare[i % spare.length] : (base + 3) % MOD;
        board[i] = rr + MOD * randInt(0, 2);
      }
    }
    this.vals = board;
    this.startVal = base;
    this.trail = path.length > 0 ? [path[0]] : [];
    this.pos = path.length > 0 ? path[0] : -1;
    this.step = 0;
    this.err = 0;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.startAt = Date.now();
    this.msg = '从 ' + base + ' 出发，每次走到相邻且 +1（满 ' + MOD + ' 归 0）的格子';
  }

  private tap(i: number): void {
    if (this.over || this.pos < 0 || i === this.pos) {
      return;
    }
    const r1: number = Math.floor(this.pos / GRID);
    const c1: number = this.pos % GRID;
    const r2: number = Math.floor(i / GRID);
    const c2: number = i % GRID;
    const near: boolean = Math.abs(r1 - r2) + Math.abs(c1 - c2) === 1;
    const want: number = (this.startVal + this.step + 1) % MOD;
    const val: number = this.vals[i];
    if (near && val === want) {
      this.step = this.step + 1;
      this.pos = i;
      const t: number[] = this.trail.slice();
      t.push(i);
      this.trail = t;
      this.msg = '✅ 走到 ' + val;
      if (this.step >= PATH_LEN - 1) {
        this.msg = '🎉 整条模路径走通！';
        this.finish(true);
      }
      return;
    }
    this.err = this.err + 1;
    if (this.err >= this.diffTotal) {
      this.msg = '❌ 踩错 ' + this.diffTotal + ' 次，路断了';
      this.finish(false);
      return;
    }
    this.msg = near ? ('❌ 这一格是 ' + val + '，要的是 ' + want) : '❌ 只能走上下左右相邻的格子';
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    this.over = true;
    this.won = solved;
    const r: GameResult = {
      gameId: 'modulo_path',
      solved: solved,
      score: solved ? Math.max(100, 800 - this.err * 200) : this.step * 100,
      durationMs: Date.now() - this.startAt,
      levelReached: this.step
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  private trailRank(i: number): number {
    return this.trail.indexOf(i);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('进度'), (this.step) + '/' + (PATH_LEN - 1))
        this.stat(TG('失误'), this.err + '/' + this.diffTotal)
        this.stat('下一格', String((this.startVal + this.step + 1) % MOD))
      }.width('100%')

      Column({ space: Space.sm }) {
        ForEach([0, 1, 2, 3, 4], (r: number) => {
          Row({ space: Space.sm }) {
            ForEach([0, 1, 2, 3, 4], (c: number) => {
              this.cell(r * GRID + c)
            }, (c: number) => 'mc' + c)
          }.width('100%')
        }, (r: number) => 'mr' + r)
      }.width('100%').layoutWeight(1)

      Text(this.msg).fontSize(FontSize.sm).fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft).width('100%')

      Button(this.over ? (this.won ? TG('已通关 🎉') : TG('再来一局')) : TG('重开')).fontSize(FontSize.md).fontColor(Color.White).backgroundColor(Palette.amber).borderRadius(Radius.md).width('100%').height(46).onClick(() => {
          this.reset();
        })
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }.layoutWeight(1).padding(Space.sm).backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  cell(i: number) {
    Stack() {
      Text(String(this.vals[i])).fontSize(FontSize.xl).fontWeight(FontWeight.Bold).fontColor(this.trailRank(i) >= 0 ? '#FFFFFF' : this.theme.ink)
    }.layoutWeight(1).aspectRatio(1).backgroundColor(this.trailRank(i) >= 0 ? Palette.amber
      : (i === this.pos ? '#33F59E0B' : this.theme.surface)).borderRadius(Radius.md).shadow(Shadow.card).animation({ duration: Motion.fast, curve: Motion.snap() }).onClick(() => {
      this.tap(i);
    })
  }
}
