/** 语义联想 —— 挑出与线索词关系最紧的搭档词｜胜负：10 题答对 ≥7 通关 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const ROUNDS: number = 10; const PASS: number = 7; const GAP_MS: number = 700;

/** 强关联词对：[线索, 搭档] */
const PAIRS: string[][] = [
  ['针', '线'], ['锁', '钥匙'], ['笔', '纸'], ['茶', '杯'],
  ['雨', '伞'], ['夜', '灯'], ['锅', '铲'], ['蜂', '蜜'],
  ['雪', '冬'], ['火', '柴'], [TG('桥'), '河'], ['医', '药'],
  ['鞋', '袜'], ['电脑', '键盘'], ['太阳', '光'], ['风筝', '线轴']
];

function shufStr(src: string[]): string[] {
  const out: string[] = src.slice();
  for (let i = out.length - 1; i > 0; i--) {
    const j: number = Math.floor(Math.random() * (i + 1));
    const t: string = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

@Component
export struct GSemanticAssociation {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：ROUNDS 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.sizeNow(ROUNDS);
  onFinish: (r: GameResult) => void = () => {};

  @State cue: string = ''; @State opts: string[] = []; @State ans: number = 0;
  @State picked: number = -1; @State qi: number = 0; @State right: number = 0;
  @State score: number = 0; @State msg: string = ''; @State over: boolean = false;
  @State won: boolean = false;
  private startAt: number = 0; private feed: number = -1; private done: boolean = false;

  aboutToAppear(): void { LanRace.noteStart(); this.startAt = Date.now(); this.reset(); }
  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(ROUNDS);
     this.reset(); }
  aboutToDisappear(): void { this.stop(); }
  private stop(): void { if (this.feed >= 0) { clearTimeout(this.feed); this.feed = -1; } }

  private reset(): void {
    this.stop();
    this.qi = 0; this.right = 0; this.score = 0; this.over = false; this.won = false; this.done = false;
    this.startAt = Date.now(); this.next();
  }

  private next(): void {
    const pi: number = Math.floor(Math.random() * PAIRS.length);
    const pair: string[] = PAIRS[pi];
    const pool: string[] = [];
    for (let i = 0; i < PAIRS.length; i++) { if (i !== pi) { pool.push(PAIRS[i][1]); } }
    const mixed: string[] = shufStr(pool);
    const four: string[] = shufStr([pair[1], mixed[0], mixed[1], mixed[2]]);
    this.cue = pair[0]; this.opts = four; this.ans = four.indexOf(pair[1]);
    this.picked = -1; this.msg = '提到「' + pair[0] + '」，最先想到哪个？';
  }

  private pick(i: number): void {
    if (this.over || this.picked >= 0) { return; }
    this.picked = i;
    if (i === this.ans) {
      this.right = this.right + 1; this.score = this.score + 100;
      this.msg = '✅ ' + this.cue + ' ↔ ' + this.opts[i];
    } else { this.msg = '❌ 更贴切的是 ' + this.opts[this.ans]; }
    if (this.qi + 1 >= this.diffTotal) {
      this.over = true; this.won = this.right >= PASS;
      this.msg = (this.won ? TG('🎉 通关：') : TG('💤 结束：')) + TG('答对 ') + this.right + ' / ' + this.diffTotal;
      this.finish(this.won); return;
    }
    this.qi = this.qi + 1;
    this.feed = setTimeout(() => { this.feed = -1; this.next(); }, GAP_MS);
  }

  private finish(solved: boolean): void {
    if (this.done) { return; }
    this.done = true;
    const r: GameResult = { gameId: 'semantic_association', solved: solved, score: this.score,
      durationMs: Date.now() - this.startAt, levelReached: this.right };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('题号'), Math.min(this.qi + 1, this.diffTotal) + '/' + this.diffTotal, Palette.sky)
        this.stat(TG('答对'), this.right + '/' + PASS, Palette.emerald)
        this.stat(TG('得分'), String(this.score), Palette.amber)
      }.width('100%')

      Column({ space: Space.xs }) {
        Text('📖 语义联想').fontSize(FontSize.xs).fontColor(this.theme.inkFaint)
        Text(this.cue).fontSize(FontSize.hero).fontWeight(FontWeight.Bold).fontColor(Palette.primaryDeep)
      }.width('100%').padding(Space.lg).backgroundColor(this.theme.surface)
      .borderRadius(Radius.lg).shadow(Shadow.card).animation({ duration: Motion.fast, curve: Motion.snap() })

      Row({ space: Space.sm }) {
        this.optKey(0)
        this.optKey(1)
      }.width('100%')
      Row({ space: Space.sm }) {
        this.optKey(2)
        this.optKey(3)
      }.width('100%')

      Text(this.msg).fontSize(FontSize.sm).fontWeight(FontWeight.Bold).width('100%').textAlign(TextAlign.Center)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)
      Button(TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF').backgroundColor(Palette.primary)
        .borderRadius(Radius.md).width('100%').height(46).onClick(() => { this.reset(); })
      Text(this.diffTotal + TG(' 题，答对 ≥') + PASS + TG(' 通关')).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string, tone: string) {
    Column({ space: Space.xs }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.md).fontWeight(FontWeight.Bold).fontColor(tone)
    }.layoutWeight(1).padding(Space.xs).backgroundColor(this.theme.surface)
    .borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  optKey(i: number) {
    Button(this.opts.length > i ? this.opts[i] : '').fontSize(FontSize.lg).fontColor('#FFFFFF')
      .backgroundColor(this.picked < 0 ? Palette.primaryDeep
        : (i === this.ans ? Palette.emerald : (i === this.picked ? Palette.rose : this.theme.lineSoft)))
      .borderRadius(Radius.md).layoutWeight(1).height(56)
      .animation({ duration: Motion.fast, curve: Motion.snap() })
      .enabled(!this.over && this.picked < 0).onClick(() => { this.pick(i); })
  }
}
