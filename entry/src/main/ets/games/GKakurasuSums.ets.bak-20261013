/**
 * 黑白和（Kakurasu）⚫
 *
 * 规则：每格涂黑或留白。第 r 行左侧的数字 = 该行黑格所在**列号之和**；
 *       第 c 列上方的数字 = 该列黑格所在**行号之和**（列号/行号从 1 数起）。
 * 胜负：行、列全部对上 = 通关；步数用尽 = 失败。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 5;
const MAX_MOVES: number = 150;
const LBL_W: number = 40;

@Component
export struct GKakurasuSums {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（lives）：MAX_MOVES 按难度换算
  @State private diffTotal: number = GameDiff.livesNow(MAX_MOVES);
  onFinish: (r: GameResult) => void = () => {};

  @State private black: boolean[] = [];
  @State private rowLab: number[] = [];
  @State private colLab: number[] = [];
  @State private moves: number = 0;
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private pressed: number = -1;

  private startAt: number = 0;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.livesNow(MAX_MOVES);
    this.reset();
  }

  private reset(): void {
    let b: boolean[] = [];
    let ok: boolean = false;
    let guard: number = 0;
    while (!ok && guard < 40) {
      guard++;
      b = new Array<boolean>(N * N).fill(false);
      let blk: number = 0;
      for (let i = 0; i < N * N; i++) {
        if (Math.random() < 0.45) {
          b[i] = true;
          blk++;
        }
      }
      ok = blk >= 4 && blk <= N * N - 4;
    }
    const rowLab: number[] = new Array<number>(N).fill(0);
    const colLab: number[] = new Array<number>(N).fill(0);
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        if (b[r * N + c]) {
          rowLab[r] += c + 1;
          colLab[c] += r + 1;
        }
      }
    }
    this.rowLab = rowLab;
    this.colLab = colLab;
    this.black = new Array<boolean>(N * N).fill(false);
    this.moves = 0;
    this.over = false;
    this.won = false;
    this.pressed = -1;
    this.startAt = Date.now();
  }

  private rowSum(r: number): number {
    let s: number = 0;
    for (let c = 0; c < N; c++) {
      if (this.black[r * N + c]) {
        s += c + 1;
      }
    }
    return s;
  }

  private colSum(c: number): number {
    let s: number = 0;
    for (let r = 0; r < N; r++) {
      if (this.black[r * N + c]) {
        s += r + 1;
      }
    }
    return s;
  }

  private rowOk(r: number): boolean {
    return this.rowSum(r) === this.rowLab[r];
  }

  private colOk(c: number): boolean {
    return this.colSum(c) === this.colLab[c];
  }

  private okLines(): number {
    let n: number = 0;
    for (let i = 0; i < N; i++) {
      if (this.rowOk(i)) {
        n++;
      }
      if (this.colOk(i)) {
        n++;
      }
    }
    return n;
  }

  private blackCount(): number {
    let n: number = 0;
    for (let i = 0; i < N * N; i++) {
      if (this.black[i]) {
        n++;
      }
    }
    return n;
  }

  private tap(i: number): void {
    if (this.over) {
      return;
    }
    const b: boolean[] = this.black.slice();
    b[i] = !b[i];
    this.black = b;
    this.moves++;
    if (this.okLines() === 2 * N) {
      this.over = true;
      this.won = true;
      this.finish(true);
      return;
    }
    if (this.moves >= this.diffTotal) {
      this.over = true;
      this.finish(false);
    }
  }

  private finish(solved: boolean): void {
    const r: GameResult = {
      gameId: 'kakurasu_sums',
      solved: solved,
      score: solved ? Math.max(200, 1400 - this.moves * 8) : this.okLines() * 90,
      durationMs: Date.now() - this.startAt,
      levelReached: this.okLines()
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.md }) {
        this.infoBox(TG('黑格'), String(this.blackCount()))
        this.infoBox('达标线', String(this.okLines()) + '/' + String(2 * N))
        this.infoBox(TG('步数'), String(this.moves))
      }
      .width('100%')

      Column({ space: 2 }) {
        Row({ space: 2 }) {
          Row() {
          }
          .width(LBL_W)
          ForEach([0, 1, 2, 3, 4], (c: number) => {
            this.headLab(c, false)
          }, (c: number) => 'ksh' + c)
        }
        .width('100%')

        ForEach([0, 1, 2, 3, 4], (r: number) => {
          Row({ space: 2 }) {
            this.headLab(r, true)
            ForEach([0, 1, 2, 3, 4], (c: number) => {
              this.cellBox(r * N + c)
            }, (c: number) => 'ks' + r + '-' + c)
          }
          .width('100%')
        }, (r: number) => 'ksr' + r)
      }
      .width('100%')
      .padding(Space.sm)
      .backgroundColor(this.theme.surfaceAlt)
      .borderRadius(Radius.md)

      Row({ space: Space.md }) {
        Button(this.over ? (this.won ? TG('🎉 已通关') : TG('已结束')) : '点格子涂黑 / 擦白')
          .fontSize(FontSize.sm)
          .fontColor(this.theme.inkSoft)
          .backgroundColor(this.theme.surfaceAlt)
          .borderRadius(Radius.md)
          .layoutWeight(1)
          .height(44)
          .enabled(false)
        Button(TG('重开'))
          .fontSize(FontSize.md)
          .fontColor(Color.White)
          .backgroundColor(Palette.primary)
          .borderRadius(Radius.md)
          .width(96)
          .height(44)
          .onClick(() => {
            this.reset();
          })
      }
      .width('100%')

      Text('上方数字 = 该列黑格的行号之和；左侧数字 = 该行黑格的列号之和（行/列号从 1 起）')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  infoBox(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value)
        .fontSize(FontSize.lg)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }

  /** 行/列提示数：目标 + 当前（对上了变绿） */
  @Builder
  headLab(i: number, isRow: boolean) {
    Column({ space: 2 }) {
      Text(String(isRow ? this.rowLab[i] : this.colLab[i]))
        .fontSize(FontSize.md)
        .fontWeight(FontWeight.Bold)
        .fontColor(isRow ? (this.rowOk(i) ? Palette.emerald : this.theme.ink) :
          (this.colOk(i) ? Palette.emerald : this.theme.ink))
      Text(String(isRow ? this.rowSum(i) : this.colSum(i)))
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width(LBL_W)
    .height(LBL_W)
    .justifyContent(FlexAlign.Center)
  }

  @Builder
  cellBox(i: number) {
    Stack() {
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.black[i] ? (this.theme.isDark ? '#0B0B0B' : '#1F2937') : this.theme.surface)
    .borderRadius(Radius.xs)
    .scale({
      x: this.pressed === i ? Motion.pressScale : 1,
      y: this.pressed === i ? Motion.pressScale : 1
    })
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onTouch((e: TouchEvent) => {
      if (e.type === TouchType.Down) {
        this.pressed = i;
      } else if (e.type === TouchType.Up || e.type === TouchType.Cancel) {
        this.pressed = -1;
      }
    })
    .onClick(() => {
      this.tap(i);
    })
  }
}
