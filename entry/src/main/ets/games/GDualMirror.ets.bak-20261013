/**
 * 双镜像 —— 两块 4×4 灯板，一次点击**两块同时变**，且左右是镜像位置
 *
 * 玩法：点左板 (r,c) ⇒ 左板 (r,c) 与右板 (r,3-c) 同时翻转；点右板同理。
 *       目标：把两块板的灯全部熄灭。
 * 胜负：全灭 ⇒ solved=true；步数超过 MOVE_LIMIT 还没灭 ⇒ solved=false
 * 保证有解：开局就是把「全灭」状态用同一套镜像操作随机翻几下得到的，倒着点回去即可复原
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N: number = 4;
const MOVE_LIMIT: number = 20;
const SCRAMBLE_MIN: number = 4;
const SCRAMBLE_MAX: number = 6;

function range(n: number): number[] {
  const a: number[] = [];
  for (let i = 0; i < n; i++) {
    a.push(i);
  }
  return a;
}

@Component
export struct GDualMirror {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（lives）：MOVE_LIMIT 按难度换算
  @State private diffTotal: number = GameDiff.livesNow(MOVE_LIMIT);
  onFinish: (r: GameResult) => void = () => {};

  @State private left: number[] = [];
  @State private right: number[] = [];
  @State private moves: number = 0;
  @State private msg: string = '点任意一格格子，两块板会同时镜像翻转';
  @State private over: boolean = false;
  @State private won: boolean = false;

  private startAt: number = 0;
  private finished: boolean = false;
  private rows: number[] = range(N);

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  onRestart(): void {
    this.diffTotal = GameDiff.livesNow(MOVE_LIMIT);
    this.reset();
  }

  private reset(): void {
    let l: number[] = [];
    let r: number[] = [];
    for (let t = 0; t < 12; t++) {
      l = new Array<number>(N * N).fill(0);
      r = new Array<number>(N * N).fill(0);
      const times: number = SCRAMBLE_MIN + Math.floor(Math.random() * (SCRAMBLE_MAX - SCRAMBLE_MIN + 1));
      for (let k = 0; k < times; k++) {
        const cell: number = Math.floor(Math.random() * N * N);
        this.flip(l, r, cell);
      }
      if (this.lit(l) + this.lit(r) > 0) {
        break;
      }
    }
    this.left = l;
    this.right = r;
    this.moves = 0;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.msg = '点任意一格格子，两块板会同时镜像翻转';
    this.startAt = Date.now();
  }

  /** 一次镜像翻转：同板 (r,c) + 另一板 (r, N-1-c) */
  private flip(l: number[], r: number[], cell: number): void {
    const row: number = Math.floor(cell / N);
    const col: number = cell % N;
    const other: number = row * N + (N - 1 - col);
    l[cell] = l[cell] === 0 ? 1 : 0;
    r[other] = r[other] === 0 ? 1 : 0;
  }

  private lit(board: number[]): number {
    let n: number = 0;
    for (let i = 0; i < board.length; i++) {
      if (board[i] === 1) {
        n++;
      }
    }
    return n;
  }

  private tap(side: number, cell: number): void {
    if (this.over) {
      return;
    }
    const l: number[] = this.left.slice();
    const r: number[] = this.right.slice();
    if (side === 1) {
      this.flip(r, l, cell);
    } else {
      this.flip(l, r, cell);
    }
    this.left = l;
    this.right = r;
    this.moves++;

    if (this.lit(l) + this.lit(r) === 0) {
      this.over = true;
      this.won = true;
      this.msg = '🎉 两块板全灭了，用了 ' + this.moves + TG(' 步');
      this.finish(true);
      return;
    }
    if (this.moves >= this.diffTotal) {
      this.over = true;
      this.won = false;
      this.msg = '步数用完，还剩 ' + (this.lit(l) + this.lit(r)) + ' 盏灯';
      this.finish(false);
      return;
    }
    this.msg = TG('已走 ') + this.moves + ' 步 · 还剩 ' + (this.lit(l) + this.lit(r)) + ' 盏灯';
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    const r: GameResult = {
      gameId: 'dual_mirror',
      solved: solved,
      score: solved ? Math.max(80, 400 - this.moves * 15) : 0,
      durationMs: Date.now() - this.startAt,
      levelReached: this.moves
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.sm }) {
      Row({ space: Space.sm }) {
        this.stat(TG('步数'), this.moves + ' / ' + this.diffTotal, Palette.primary)
        this.stat('剩余灯', String(this.lit(this.left) + this.lit(this.right)), Palette.amber)
        this.stat(TG('状态'), this.over ? (this.won ? '通关' : TG('结束')) : '进行中',
          this.over ? (this.won ? Palette.emerald : Palette.rose) : Palette.sky)
      }
      .width('100%')

      Row({ space: Space.sm }) {
        Column({ space: Space.xs }) {
          Text('左板').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
          Column({ space: 2 }) {
            ForEach(this.rows, (r: number) => {
              Row({ space: 2 }) {
                ForEach(this.rows, (c: number) => {
                  this.cellView(0, r * N + c)
                }, (c: number) => 'lc' + c)
              }
              .width('100%')
              .layoutWeight(1)
            }, (r: number) => 'lr' + r)
          }
          .width('100%')
          .aspectRatio(1)
          .padding(Space.xs)
          .backgroundColor(this.theme.surfaceAlt)
          .borderRadius(Radius.md)
          .shadow(Shadow.card)
        }
        .layoutWeight(1)

        Column({ space: Space.xs }) {
          Text('右板（镜像）').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
          Column({ space: 2 }) {
            ForEach(this.rows, (r: number) => {
              Row({ space: 2 }) {
                ForEach(this.rows, (c: number) => {
                  this.cellView(1, r * N + c)
                }, (c: number) => 'rc' + c)
              }
              .width('100%')
              .layoutWeight(1)
            }, (r: number) => 'rr' + r)
          }
          .width('100%')
          .aspectRatio(1)
          .padding(Space.xs)
          .backgroundColor(this.theme.surfaceAlt)
          .borderRadius(Radius.md)
          .shadow(Shadow.card)
        }
        .layoutWeight(1)
      }
      .width('100%')
      .alignItems(VerticalAlign.Top)

      Text(this.msg)
        .fontSize(FontSize.sm)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Button(TG('重开'))
        .fontSize(FontSize.md)
        .fontColor(Color.White)
        .backgroundColor(Palette.primary)
        .borderRadius(Radius.md)
        .width('100%')
        .height(46)
        .onClick(() => {
          this.reset();
        })

      Text('点左板 (r,c) ⇒ 左 (r,c) 与右 (r,' + (N - 1) + '-c) 同时翻转；点右板同理。把两块板都熄掉通关')
        .fontSize(FontSize.xxs)
        .fontColor(this.theme.inkFaint)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string, color: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.md).fontWeight(FontWeight.Bold).fontColor(color)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }

  @Builder
  cellView(side: number, cell: number) {
    Stack() {
      if (this.on(side, cell)) {
        Row()
          .width('70%')
          .aspectRatio(1)
          .backgroundColor(Palette.amber)
          .borderRadius(Radius.full)
          .shadow(Shadow.card)
      }
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.on(side, cell) ? '#33F59E0B' : this.theme.surface)
    .borderRadius(Radius.xs)
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => {
      this.tap(side, cell);
    })
  }

  /** 该格是否亮着（side 0 = 左板，1 = 右板） */
  private on(side: number, cell: number): boolean {
    const b: number[] = side === 0 ? this.left : this.right;
    return b.length > cell && b[cell] === 1;
  }
}
