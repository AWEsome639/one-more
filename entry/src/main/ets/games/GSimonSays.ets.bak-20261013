/**
 * 西蒙说（Simon Says）—— 跟着做动作
 *
 * 玩法：四个色块依次亮起，按同样的顺序点回去；每过一关序列加长一位。
 * 结算：按错 ⇒ 失败；撑到第 12 关 ⇒ 通关。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const PADS: number = 4;
const WIN_LEN: number = 12;   // 难度会覆盖它        // 通关长度
const SHOW_TICK: number = 430;     // 演示时每半拍
const FLASH_MS: number = 180;      // 点中时的闪光
const GAP_MS: number = 700;        // 过关后到下一关
const PAD_COLORS: string[] = [Palette.emerald, Palette.rose, Palette.sky, Palette.amber];
const PAD_ICON: string[] = ['🐸', '🍎', '💧', '⭐'];
const IDX: number[] = [0, 1, 2, 3];

@Component
export struct GSimonSays {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;
  // ★ 难度作用到玩法：通关序列长度（简单 8 步 / 普通 12 / 困难 16）
  private winLen: number = GameDiff.pick(8, 12, 16);

  onFinish: (r: GameResult) => void = () => {};

  @State private lit: number = -1;
  @State private len: number = 0;
  @State private score: number = 0;
  @State private phase: string = 'show';    // show | input | over
  @State private over: boolean = false;
  @State private won: boolean = false;
  @State private msg: string = '';

  private seq: number[] = [];
  private showIdx: number = -1;
  private inputIdx: number = 0;
  private showTimer: number = -1;
  private flashTimer: number = -1;
  private gapTimer: number = -1;
  private startAt: number = 0;
  private finished: boolean = false;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  /** 宿主点了「换一局」 */
  onRestart(): void {
    this.winLen = GameDiff.pick(8, 12, 16);
    this.reset();
  }

  aboutToDisappear(): void {
    this.clearTimers();
  }

  private clearTimers(): void {
    if (this.showTimer >= 0) {
      clearInterval(this.showTimer);
      this.showTimer = -1;
    }
    if (this.flashTimer >= 0) {
      clearTimeout(this.flashTimer);
      this.flashTimer = -1;
    }
    if (this.gapTimer >= 0) {
      clearTimeout(this.gapTimer);
      this.gapTimer = -1;
    }
  }

  private reset(): void {
    this.clearTimers();
    this.seq = [];
    this.len = 0;
    this.score = 0;
    this.lit = -1;
    this.over = false;
    this.won = false;
    this.finished = false;
    this.startAt = Date.now();
    this.nextRound();
  }

  /** 序列加长一位，然后演示 */
  private nextRound(): void {
    this.seq.push(Math.floor(Math.random() * PADS));
    this.len = this.seq.length;
    this.showIdx = -1;
    this.inputIdx = 0;
    this.lit = -1;
    this.phase = 'show';
    this.msg = '看好了… 第 ' + this.len + TG(' 关');
    if (this.showTimer >= 0) {
      clearInterval(this.showTimer);
    }
    this.showTimer = setInterval(() => {
      this.showStep();
    }, SHOW_TICK);
  }

  /** 演示一步：先灭掉上一个，再亮下一个 */
  private showStep(): void {
    if (this.lit >= 0) {
      this.lit = -1;
      return;
    }
    if (this.showIdx + 1 < this.seq.length) {
      this.showIdx++;
      this.lit = this.seq[this.showIdx];
      return;
    }
    if (this.showTimer >= 0) {
      clearInterval(this.showTimer);
      this.showTimer = -1;
    }
    this.lit = -1;
    this.phase = 'input';
    this.inputIdx = 0;
    this.msg = '轮到你了，按顺序点 ' + this.len + TG(' 下');
  }

  private tapPad(i: number): void {
    if (this.phase !== 'input' || this.over) {
      return;
    }
    if (this.seq[this.inputIdx] !== i) {
      this.fail();
      return;
    }
    this.flash(i);
    this.inputIdx++;
    if (this.inputIdx < this.seq.length) {
      return;
    }
    // 这一关过了
    this.score += this.len * 10;
    this.phase = 'wait';
    this.msg = TG('✅ 第 ') + this.len + ' 关通过';
    if (this.len >= this.winLen) {
      this.won = true;
      this.over = true;
      this.phase = 'over';
      this.msg = '🎉 撑到第 ' + this.winLen + ' 关，通关！';
      this.clearTimers();
      this.finish(true);
      return;
    }
    if (this.gapTimer >= 0) {
      clearTimeout(this.gapTimer);
    }
    this.gapTimer = setTimeout(() => {
      this.gapTimer = -1;
      this.nextRound();
    }, GAP_MS);
  }

  private flash(i: number): void {
    this.lit = i;
    if (this.flashTimer >= 0) {
      clearTimeout(this.flashTimer);
    }
    this.flashTimer = setTimeout(() => {
      this.flashTimer = -1;
      this.lit = -1;
    }, FLASH_MS);
  }

  private fail(): void {
    this.over = true;
    this.won = false;
    this.phase = 'over';
    this.lit = -1;
    this.msg = '❌ 按错了，最长撑到 ' + this.len + TG(' 关');
    this.clearTimers();
    this.finish(false);
  }

  private finish(solved: boolean): void {
    if (this.finished) {
      return;
    }
    this.finished = true;
    const r: GameResult = {
      gameId: 'simon_says',
      solved: solved,
      score: this.score,
      durationMs: Date.now() - this.startAt,
      levelReached: this.len
    };
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish(r);
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('关卡'), this.len + '/' + this.winLen)
        this.stat(TG('得分'), String(this.score))
        this.stat(TG('状态'), this.phase === 'input' ? '你来' : (this.phase === 'show' ? '演示' : TG('结束')))
      }
      .width('100%')

      Column({ space: Space.sm }) {
        Row({ space: Space.sm }) {
          this.pad(0)
          this.pad(1)
        }
        .width('100%')
        Row({ space: Space.sm }) {
          this.pad(2)
          this.pad(3)
        }
        .width('100%')
      }
      .width('100%')

      Text(this.msg)
        .fontSize(FontSize.md)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.over ? (this.won ? Palette.emerald : Palette.rose) : this.theme.inkSoft)

      Button(TG('重新开始'))
        .fontSize(FontSize.md)
        .fontColor(Color.White)
        .backgroundColor(Palette.orange)
        .borderRadius(Radius.md)
        .width('100%')
        .height(46)
        .onClick(() => {
          this.reset();
        })
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value)
        .fontSize(FontSize.lg)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.theme.ink)
    }
    .layoutWeight(1)
    .padding(Space.sm)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
  }

  @Builder
  pad(i: number) {
    Stack() {
      Text(PAD_ICON[i]).fontSize(FontSize.xxxl)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.lit === i ? Palette.amber : PAD_COLORS[i])
    .borderRadius(Radius.lg)
    .shadow(this.lit === i ? Shadow.lifted : Shadow.card)
    .scale({ x: this.lit === i ? 1.06 : 1, y: this.lit === i ? 1.06 : 1 })
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => {
      this.tapPad(i);
    })
  }
}
