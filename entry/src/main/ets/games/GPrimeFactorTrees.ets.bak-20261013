/** 质因数树 —— 把合数一路拆成质因数｜5 棵拆开 4 棵过关 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const ROUNDS: number = 5;
const PASS: number = 4;
const PRIMES: number[] = [2, 3, 5, 7, 11, 13];
const POOL: number[] = [12, 18, 20, 24, 28, 30, 36, 40, 42, 45, 48, 50, 54, 56, 60, 63, 70, 72, 84, 90, 96, 100, 108, 120, 126, 132, 144];

@Component
export struct GPrimeFactorTrees {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法（size）：ROUNDS 按难度换算（简单/普通/困难）
  @State private diffTotal: number = GameDiff.sizeNow(ROUNDS);
  onFinish: (r: GameResult) => void = () => {};
  @State private target: number = 12;
  @State private rest: number = 12;
  @State private chain: string[] = [];
  @State private level: number = 0;
  @State private clears: number = 0;
  @State private score: number = 0;
  @State private miss: number = 0;
  @State private over: boolean = false;
  @State private tip: string = '点能整除的质数';
  private startAt: number = 0;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.startAt = Date.now();
    this.reset();
  }
  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(ROUNDS);
     this.reset(); }

  private reset(): void {
    this.startAt = Date.now();
    this.level = 0;
    this.clears = 0;
    this.score = 0;
    this.over = false;
    this.load();
  }

  private load(): void {
    this.target = POOL[Math.floor(Math.random() * POOL.length)];
    this.rest = this.target;
    this.chain = [];
    this.miss = 0;
    this.tip = '把 ' + String(this.target) + ' 拆成质因数';
  }

  private tap(p: number): void {
    if (this.over || this.rest <= 1) { return; }
    if (this.rest % p === 0) {
      this.rest = this.rest / p;
      const c: string[] = this.chain.slice();
      c.push(String(p));
      this.chain = c;
      this.score += 4;
      if (this.rest === 1) {
        this.clears++;
        this.score += 10;
        this.next('✓ ' + this.chain.join(' × ') + ' = ' + String(this.target));
      } else {
        this.tip = '还剩 ' + String(this.rest) + '，继续拆';
      }
      return;
    }
    this.miss++;
    this.tip = String(p) + ' 除不尽 ' + String(this.rest) + '，换一个';
    if (this.miss >= 3) { this.next('✗ ' + String(this.target) + ' 没能拆完'); }
  }

  private next(msg: string): void {
    this.level++;
    if (this.level >= this.diffTotal) {
      this.over = true;
      this.tip = msg + '｜共拆开 ' + String(this.clears) + '/' + String(this.diffTotal) + ' 棵';
      const res: GameResult = {
        gameId: 'prime_factor_trees', solved: this.clears >= PASS,
        score: this.score, durationMs: Date.now() - this.startAt, levelReached: this.clears
      };
      LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
      this.onFinish(res);
      return;
    }
    this.load();
    this.tip = msg + '，接着下一棵';
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('关卡'), String(Math.min(this.level + 1, this.diffTotal)) + '/' + String(this.diffTotal))
        this.stat('已拆开', String(this.clears))
        this.stat(TG('失误'), String(this.miss) + '/3')
      }.width('100%')
      Column({ space: Space.xs }) {
        Text(String(this.rest)).fontSize(FontSize.hero).fontWeight(FontWeight.Bold)
          .fontColor(this.rest > 1 ? this.theme.ink : Palette.emerald)
        Text('目标数 ' + String(this.target)).fontSize(FontSize.xs).fontColor(this.theme.inkFaint)
        Text(this.chain.length > 0 ? this.chain.join(' × ') + (this.rest > 1 ? ' × …' : '') : '还没有拆下任何因子')
          .fontSize(FontSize.lg).fontColor(Palette.cyan)
      }.width('100%').padding(Space.md).backgroundColor(this.theme.surface)
      .borderRadius(Radius.lg).shadow(Shadow.card).animation({ duration: Motion.fast, curve: Motion.snap() })
      Text(this.tip).fontSize(FontSize.sm).fontColor(this.theme.inkSoft)
      Row({ space: Space.xs }) {
        ForEach(PRIMES, (p: number) => { this.pBtn(p); }, (p: number) => 'p' + p)
      }.width('100%')
      Row({ space: Space.md }) {
        Button(TG('重开')).fontSize(FontSize.md).fontColor('#FFFFFF').backgroundColor(Palette.cyan)
          .borderRadius(Radius.md).width(120).height(44).onClick(() => { this.reset(); })
        Text('质因数连乘起来 = 目标数').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      }.width('100%')
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.md).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }.layoutWeight(1).padding(Space.xs).backgroundColor(this.theme.surface).borderRadius(Radius.sm).shadow(Shadow.card)
  }

  @Builder
  pBtn(p: number) {
    Button(String(p)).fontSize(FontSize.lg).fontColor(this.theme.ink).backgroundColor(this.theme.surfaceAlt)
      .borderRadius(Radius.md).layoutWeight(1).height(52).enabled(!this.over && this.rest > 1)
      .onClick(() => { this.tap(p); })
  }
}
