/**
 * 心理地图 —— 构建空间地图
 *
 * 玩法：屏幕先亮出几个地点（emoji）的位置，记住后它们隐去；
 * 然后按提示「从 A 走到 B 要往哪个方向」，凭记忆在九宫格上点出方向。
 * 答对越多分越高，答错 3 次结束。
 *
 * 原创实现（拾海 2026-10-10）。
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const N = 3;              // 3×3 地图
const CELLS = N * N;
const SPOTS = 4;          // 记住 4 个地点（难度会覆盖它）
const DIRS = ['↖', '↑', '↗', '←', '', '→', '↙', '↓', '↘'];
const EMOJIS = ['🏠', '🌳', '⛲', '🏫', '🏪', '🚏', '🏥', '🏦', '🎪'];

@Component
export struct GMentalMapping {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法：要记住几个地点（简单 3 / 普通 4 / 困难 6）
  @State private spotCount: number = GameDiff.pick(3, 4, 6);
  onFinish: (r: GameResult) => void = () => {};

  @State private spots: string[] = [];     // 每格放什么（'' = 空）
  @State private px: number = 0;
  @State private py: number = 0;
  @State private tx: number = 0;
  @State private ty: number = 0;
  @State private showMap: boolean = true;
  @State private asked: number = 0;
  @State private right: number = 0;
  @State private wrong: number = 0;
  @State private over: boolean = false;
  @State private lastOk: number = 0;       // 0 无 1 对 2 错
  private startAt: number = 0;
  private timerId: number = -1;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.startAt = Date.now();
    this.reset();
  }

  onRestart(): void {
    this.spotCount = GameDiff.pick(3, 4, 6);
    this.reset();
  }

  aboutToDisappear(): void {
    if (this.timerId >= 0) {
      clearTimeout(this.timerId);
      this.timerId = -1;
    }
  }

  private reset(): void {
    const s: string[] = new Array<string>(CELLS).fill('');
    const pool: string[] = EMOJIS.slice();
    for (let i = 0; i < this.spotCount; i++) {
      const p: number = Math.floor(Math.random() * pool.length);
      const e: string = pool[p];
      pool.splice(p, 1);
      let c: number = Math.floor(Math.random() * CELLS);
      while (s[c] !== '') {
        c = Math.floor(Math.random() * CELLS);
      }
      s[c] = e;
    }
    this.spots = s;
    this.px = 0;
    this.py = 0;
    this.asked = 0;
    this.right = 0;
    this.wrong = 0;
    this.over = false;
    this.lastOk = 0;
    this.startAt = Date.now();
    this.showMap = true;
    this.pickTarget();

    if (this.timerId >= 0) {
      clearTimeout(this.timerId);
    }
    // 3 秒后把地图藏起来
    this.timerId = setTimeout(() => {
      this.showMap = false;
      this.timerId = -1;
    }, 3000);
  }

  /** 随机挑一个目的地（不等于当前位置） */
  private pickTarget(): void {
    let c: number = Math.floor(Math.random() * CELLS);
    let guard: number = 0;
    while ((Math.floor(c / N) === this.py && c % N === this.px) && guard < 40) {
      c = Math.floor(Math.random() * CELLS);
      guard++;
    }
    this.tx = c % N;
    this.ty = Math.floor(c / N);
  }

  /** 当前位置指向目的地的大致方向（八方向） */
  private answerDir(): number {
    const dx: number = this.tx - this.px;
    const dy: number = this.ty - this.py;
    const sx: number = dx === 0 ? 0 : (dx > 0 ? 1 : -1);
    const sy: number = dy === 0 ? 0 : (dy > 0 ? 1 : -1);
    return (sy + 1) * 3 + (sx + 1);
  }

  private answer(idx: number): void {
    if (this.over || this.showMap) {
      return;
    }
    this.asked = this.asked + 1;
    if (idx === this.answerDir()) {
      this.right = this.right + 1;
      this.lastOk = 1;
      this.px = this.tx;
      this.py = this.ty;
      this.pickTarget();
      if (this.right >= 8) {
        this.finish(true);
      }
    } else {
      this.wrong = this.wrong + 1;
      this.lastOk = 2;
      if (this.wrong >= 3) {
        this.finish(false);
      }
    }
  }

  private finish(solved: boolean): void {
    this.over = true;
    LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
    this.onFinish({
      gameId: 'mental_mapping', solved: solved,
      score: this.right * 60 - this.wrong * 20,
      durationMs: Date.now() - this.startAt
    });
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.lg }) {
        this.stat(TG('答对'), String(this.right), Palette.emerald)
        this.stat(TG('答错'), String(this.wrong) + '/3', Palette.rose)
        this.stat('题数', String(this.asked), Palette.primary)
      }
      .width('100%')

      Text(this.showMap
        ? '👀 记住这几个地点的位置…'
        : (this.over
          ? (this.right >= 8 ? '🎉 地图全记住了！' : '结束啦，再来一次？')
          : '从当前位置 🧍 到 ' + this.spots[this.ty * N + this.tx] + ' 该往哪走？'))
        .fontSize(FontSize.sm)
        .fontColor(this.showMap ? Palette.amber : this.theme.inkSoft)
        .fontWeight(this.showMap ? FontWeight.Bold : FontWeight.Normal)

      // 地图
      Column({ space: 6 }) {
        ForEach([0, 1, 2], (r: number) => {
          Row({ space: 6 }) {
            ForEach([0, 1, 2], (c: number) => {
              this.cell(c, r)
            }, (c: number) => 'c' + c)
          }
          .width('100%')
        }, (r: number) => 'r' + r)
      }
      .width('100%')
      .aspectRatio(1)
      .padding(Space.sm)
      .backgroundColor(this.theme.surfaceAlt)
      .borderRadius(Radius.md)

      // 方向键盘
      Column({ space: Space.xs }) {
        Row({ space: Space.xs }) {
          this.dirBtn(0)
          this.dirBtn(1)
          this.dirBtn(2)
        }
        Row({ space: Space.xs }) {
          this.dirBtn(3)
          this.dirBtn(4)
          this.dirBtn(5)
        }
        Row({ space: Space.xs }) {
          this.dirBtn(6)
          this.dirBtn(7)
          this.dirBtn(8)
        }
      }
      .width('100%')

      if (this.lastOk !== 0) {
        Text(this.lastOk === 1 ? '✅ 对了' : '❌ 错了，它在另一边')
          .fontSize(FontSize.sm)
          .fontColor(this.lastOk === 1 ? Palette.emerald : Palette.rose)
      }

      Button(TG('重开'))
        .fontSize(FontSize.md).fontColor(Color.White)
        .backgroundColor(Palette.primary).borderRadius(Radius.md)
        .width('100%').height(44)
        .onClick(() => {
          this.reset();
        })
    }
    .width('100%')
    .height('100%')
    .padding(Space.md)
  }

  @Builder
  stat(label: string, value: string, color: string) {
    Column({ space: 2 }) {
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(color)
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
    }
    .layoutWeight(1)
  }

  @Builder
  cell(c: number, r: number) {
    Stack() {
      Text(this.shown(c, r)).fontSize(24)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.theme.surface)
    .borderRadius(Radius.sm)
    .shadow(Shadow.card)
    .animation({ duration: Motion.fast, curve: Motion.snap() })
  }

  private shown(c: number, r: number): string {
    if (this.px === c && this.py === r) {
      return '🧍';
    }
    if (this.showMap) {
      return this.spots[r * N + c];
    }
    if (this.over) {
      return this.spots[r * N + c];
    }
    return '';
  }

  @Builder
  dirBtn(i: number) {
    Text(DIRS[i])
      .fontSize(FontSize.lg)
      .fontColor(i === 4 ? this.theme.inkFaint : this.theme.ink)
      .textAlign(TextAlign.Center)
      .layoutWeight(1)
      .height(44)
      .backgroundColor(i === 4 ? this.theme.surfaceAlt : this.theme.surface)
      .borderRadius(Radius.sm)
      .shadow(Shadow.card)
      .onClick(() => {
        this.answer(i);
      })
  }
}
