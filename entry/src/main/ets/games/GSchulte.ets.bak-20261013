/**
 * 舒尔特方格 —— 专注力训练
 * 规则：按 1→25 顺序点数字，计时；点错会闪红
 * 通关：点完最后一个数
 */

import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

const SIZE: number = 5;

@Component
export struct GSchulte {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;

  // ★ 难度作用到玩法：棋盘边长（原 SIZE=5；简单 ×0.7 / 普通 ×1 / 困难 ×1.3）
  //   ⚠️ 光改常量没用 —— 渲染原本用的是写死的 [0, 1, 2, 3, 4]，上面已一并改成按尺寸生成
  @State private diffTotal: number = GameDiff.sizeNow(5);

  /** 0..diffTotal-1（读 @State 建依赖，ArkUI 才追踪得到） */
  private rowIdx(): number[] {
    const n2: number = this.diffTotal > 1 ? this.diffTotal : 2;
    const a2: number[] = [];
    for (let i2 = 0; i2 < n2; i2++) { a2.push(i2); }
    return a2;
  }
  onFinish: (r: GameResult) => void = () => {};

  @State private nums: number[] = [];
  @State private next: number = 1;
  @State private elapsed: number = 0;
  @State private wrongIdx: number = -1;
  @State private done: boolean = false;

  private startAt: number = 0;
  private timer: number = -1;

  aboutToAppear(): void {
    LanRace.noteStart();  // ★ 竞速模式：本局开始计时
    this.reset();
  }

  /** 宿主点了「换一局」 */
  onRestart(): void {
    this.diffTotal = GameDiff.sizeNow(5);
    this.reset();
  }

  aboutToDisappear(): void {
    if (this.timer >= 0) {
      clearInterval(this.timer);
    }
  }

  private reset(): void {
    const a: number[] = [];
    for (let i = 1; i <= this.diffTotal * this.diffTotal; i++) {
      a.push(i);
    }
    // Fisher–Yates 洗牌
    for (let i = a.length - 1; i > 0; i--) {
      const j: number = Math.floor(Math.random() * (i + 1));
      const t: number = a[i];
      a[i] = a[j];
      a[j] = t;
    }
    this.nums = a;
    this.next = 1;
    this.elapsed = 0;
    this.wrongIdx = -1;
    this.done = false;
    this.startAt = Date.now();
    if (this.timer >= 0) {
      clearInterval(this.timer);
    }
    this.timer = setInterval(() => {
      if (!this.done) {
        this.elapsed = Date.now() - this.startAt;
      }
    }, 100);
  }

  private tap(v: number, i: number): void {
    if (this.done) {
      return;
    }
    if (v === this.next) {
      this.next++;
      this.wrongIdx = -1;
      if (this.next > this.diffTotal * this.diffTotal) {
        this.done = true;
        if (this.timer >= 0) {
          clearInterval(this.timer);
        }
        this.elapsed = Date.now() - this.startAt;
        const sec: number = this.elapsed / 1000;
        // 越快分越高：20 秒满分 1000，线性递减，下限 100
        const sc: number = Math.max(100, Math.round(1000 - (sec - 20) * 20));
        const r: GameResult = {
          gameId: 'schulte',
          solved: true,
          score: sc,
          durationMs: this.elapsed
        };
        LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
        this.onFinish(r);
      }
    } else {
      this.wrongIdx = i;
    }
  }

  build() {
    Column({ space: Space.lg }) {
      Row({ space: Space.md }) {
        this.info(TG('目标'), String(this.next))
        this.info(TG('用时'), (this.elapsed / 1000).toFixed(1) + 's')
        this.info(TG('进度'), this.next - 1 + '/' + this.diffTotal * this.diffTotal)
      }
      .width('100%')

      Column({ space: Space.sm }) {
        ForEach(this.rowIdx(), (r: number) => {
          Row({ space: Space.sm }) {
            ForEach(this.rowIdx(), (c: number) => {
              this.cell(this.nums[r * this.diffTotal + c], r * this.diffTotal + c)
            }, (c: number) => 'c' + c)
          }
          .width('100%')
        }, (r: number) => 'r' + r)
      }
      .width('100%')
      .layoutWeight(1)

      Text(this.done ? '🎉 完成！' : '按顺序点：' + this.next)
        .fontSize(FontSize.lg)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.done ? Palette.emerald : Palette.primary)

      Button(TG('重新开始'))
        .fontSize(FontSize.md).fontColor(Color.White)
        .backgroundColor(Palette.primary).borderRadius(Radius.md)
        .width('100%').height(46)
        .onClick(() => {
          this.reset();
        })
    }
    .width('100%').height('100%')
  }

  @Builder
  info(label: string, value: string) {
    Column({ space: 2 }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }
    .layoutWeight(1).padding(Space.sm)
    .backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  cell(v: number, i: number) {
    Stack() {
      Text(v === undefined ? '' : String(v))
        .fontSize(FontSize.xl)
        .fontWeight(FontWeight.Bold)
        .fontColor(v < this.next ? Palette.emerald : this.theme.ink)
    }
    .layoutWeight(1)
    .aspectRatio(1)
    .backgroundColor(this.wrongIdx === i ? '#33EF4444' : this.theme.surface)
    .borderRadius(Radius.md)
    .shadow(Shadow.card)
    .animation({ duration: Motion.fast, curve: Motion.snap() })
    .onClick(() => {
      this.tap(v, i);
    })
  }
}
