/**
 * 人脸特征 —— 先记住 6 张脸各自的「特质」，再凭脸回想
 * 胜负：6 题答对 ≥ 5 ⇒ 通关；进度：记脸倒计时 / 题号 / 答对数
 */
import { FontSize, Space, Radius, Palette, Motion, Theme, Shadow } from '../core/Design';
import { GameDiff } from '../core/GameDiff';
import { TG } from '../core/GameI18n';
import { GameResult } from '../core/GameRegistry';
import { LanRace } from '../core/LanRace';

interface TraitFace { icon: string; trait: string; }
interface TraitChoice { label: string; ok: boolean; }

const POOL: TraitFace[] = [
  { icon: '🧑‍🎨', trait: '爱画水彩' }, { icon: '🧑‍🚀', trait: '怕高' }, { icon: '👩‍🍳', trait: '口味偏辣' },
  { icon: '👨‍🔬', trait: '养了只猫' }, { icon: '🧝', trait: '每天晨跑' }, { icon: '🧛', trait: '只喝黑咖' },
  { icon: '👩‍🌾', trait: '会吹口琴' }, { icon: '🧑‍✈️', trait: '晕船' }, { icon: '🤠', trait: '收集邮票' },
  { icon: '🧜', trait: '爱看老电影' }, { icon: '👨‍🚒', trait: '会做甜点' }, { icon: '👩‍⚕️', trait: '怕打雷' }
];
const ROUNDS: number = 6;
const SHOW_SEC: number = 5;
const NEED: number = 5;

@Component
export struct GFaceTraitAssociation {
  @Prop theme: Theme = Theme.light();
  @Prop @Watch('onRestart') restartToken: number = 0;
  onFinish: (r: GameResult) => void = () => {};

  @State private faces: TraitFace[] = [];
  @State private opts: TraitChoice[] = [];
  @State private phase: number = 0;      // 0 记脸 1 作答 2 结束
  @State private askNo: number = 1;
  @State private rightN: number = 0;
  @State private pick: number = -1;
  // ★ 难度作用到玩法：本局时限 = 基础 × 难度倍率（简单 1.5× / 普通 1× / 困难 0.7×）
  private total: number = GameDiff.timeNow(SHOW_SEC);
  @State private secLeft: number = 0;
  @State private msg: string = '';
  @State private over: boolean = false;
  @State private won: boolean = false;

  private startAt: number = 0;
  private timer: number = -1;
  private nextTo: number = -1;
  private done: boolean = false;

  aboutToAppear(): void { LanRace.noteStart(); this.startAt = Date.now(); this.reset(); }
  onRestart(): void {
    this.total = GameDiff.timeNow(SHOW_SEC);   // 难度可能刚变过，必须重算
     this.reset(); }
  aboutToDisappear(): void { this.clearAll(); }

  private clearAll(): void {
    if (this.timer >= 0) { clearInterval(this.timer); this.timer = -1; }
    if (this.nextTo >= 0) { clearTimeout(this.nextTo); this.nextTo = -1; }
  }

  private reset(): void {
    this.clearAll();
    const bag: TraitFace[] = [];
    while (bag.length < ROUNDS) {
      const cand: TraitFace = POOL[Math.floor(Math.random() * POOL.length)];
      let dup: boolean = false;
      for (let i = 0; i < bag.length; i++) { if (bag[i].trait === cand.trait) { dup = true; } }
      if (!dup) { bag.push(cand); }
    }
    this.faces = bag;                      // 顺序本身随机，直接当出题顺序
    this.phase = 0; this.askNo = 1; this.rightN = 0; this.pick = -1; this.secLeft = this.total;
    this.over = false; this.won = false; this.done = false;
    this.msg = '把每张脸与它的特质绑在一起';
    this.startAt = Date.now();
    this.timer = setInterval(() => {
      if (this.phase !== 0) { return; }
      this.secLeft = this.secLeft - 1;
      if (this.secLeft <= 0) { this.startQuiz(); }
    }, 1000);
  }

  private startQuiz(): void {
    if (this.timer >= 0) { clearInterval(this.timer); this.timer = -1; }
    this.phase = 1;
    this.msg = '从下面选一条特质';
    this.loadQuestion();
  }

  private loadQuestion(): void {
    const target: TraitFace = this.faces[this.askNo - 1];
    const pool: TraitChoice[] = [{ label: target.trait, ok: true }];
    while (pool.length < 4) {
      const cand: TraitFace = POOL[Math.floor(Math.random() * POOL.length)];
      if (cand.trait === target.trait) { continue; }
      let dup: boolean = false;
      for (let i = 0; i < pool.length; i++) { if (pool[i].label === cand.trait) { dup = true; } }
      if (!dup) { pool.push({ label: cand.trait, ok: false }); }
    }
    const mixed: TraitChoice[] = [];
    while (pool.length > 0) { mixed.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]); }
    this.opts = mixed;
    this.pick = -1;
  }

  private answer(i: number): void {
    if (this.phase !== 1 || this.pick >= 0) { return; }
    this.pick = i;
    if (this.opts[i].ok) { this.rightN = this.rightN + 1; this.msg = '✅ 记对了'; }
    else { this.msg = '❌ 他其实「' + this.faces[this.askNo - 1].trait + '」'; }
    this.nextTo = setTimeout(() => {
      this.nextTo = -1;
      if (this.askNo >= ROUNDS) { this.judge(); return; }
      this.askNo = this.askNo + 1;
      this.msg = '从下面选一条特质';
      this.loadQuestion();
    }, 760);
  }

  private judge(): void {
    this.phase = 2; this.over = true; this.won = this.rightN >= NEED;
    this.msg = (this.won ? '🎉 通关！答对 ' : '💤 结束，答对 ') + String(this.rightN) + '/' + String(ROUNDS);
    if (!this.done) {
      this.done = true;
      const r: GameResult = {
        gameId: 'face_trait_association', solved: this.won, score: this.rightN * 100,
        durationMs: Date.now() - this.startAt, levelReached: this.rightN
      };
      LanRace.noteDone();  // ★ 竞速模式：上报用时（没在竞速时是空操作）
      this.onFinish(r);
    }
  }

  build() {
    Column({ space: Space.md }) {
      Row({ space: Space.sm }) {
        this.stat(TG('阶段'), this.phase === 0 ? '记脸' : (this.over ? TG('结束') : '作答'))
        this.stat(TG('题号'), String(this.over ? ROUNDS : this.askNo) + '/' + String(ROUNDS))
        this.stat(TG('答对'), String(this.rightN))
      }.width('100%')

      if (this.phase === 0) {
        Column({ space: Space.sm }) {
          Text('⏳ ' + String(this.secLeft) + ' 秒后开始提问')
            .fontSize(FontSize.sm).fontColor(Palette.amber).width('100%').textAlign(TextAlign.Center)
          ForEach([0, 1], (row: number) => {
            Row({ space: Space.sm }) {
              ForEach([0, 1, 2], (col: number) => {
                Column({ space: Space.xs }) {
                  Text(this.faces[row * 3 + col].icon).fontSize(FontSize.xxl)
                  Text(this.faces[row * 3 + col].trait).fontSize(FontSize.xs).fontColor(this.theme.inkSoft)
                }.layoutWeight(1).padding(Space.sm)
                .backgroundColor(this.theme.surfaceAlt).borderRadius(Radius.md)
              }, (col: number) => 'c' + col + this.faces[row * 3 + col].trait)
            }.width('100%')
          }, (row: number) => 'r' + row)
        }.width('100%').padding(Space.md)
        .backgroundColor(this.theme.surface).borderRadius(Radius.lg).shadow(Shadow.card)
      } else if (this.phase === 1) {
        Column({ space: Space.xs }) {
          Text(this.faces[this.askNo - 1].icon).fontSize(FontSize.hero)
          Text('关于他，哪一条是真的？').fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
        }.width('100%').padding(Space.lg)
        .backgroundColor(this.theme.surface).borderRadius(Radius.lg).shadow(Shadow.card)
        Column({ space: Space.sm }) { this.optBtn(0); this.optBtn(1); this.optBtn(2); this.optBtn(3) }.width('100%')
      } else {
        Column({ space: Space.xs }) {
          Text(this.won ? '🎉' : '💤').fontSize(FontSize.hero)
          Text(this.msg).fontSize(FontSize.md).fontColor(this.theme.inkSoft).textAlign(TextAlign.Center)
        }.width('100%').padding(Space.lg)
        .backgroundColor(this.theme.surface).borderRadius(Radius.lg).shadow(Shadow.card)
      }

      Text(this.msg).fontSize(FontSize.sm).fontColor(this.theme.inkSoft)
        .width('100%').textAlign(TextAlign.Center)

      Button(this.over ? TG('再来一局') : TG('重开'))
        .fontSize(FontSize.md).fontColor('#FFFFFF')
        .backgroundColor(this.over && !this.won ? Palette.rose : Palette.amber)
        .borderRadius(Radius.md).width('100%').height(Space.xxxl)
        .onClick(() => { this.reset(); })

      Text('判定：6 题答对 ≥ ' + String(NEED) + ' 即通关。特质皆为虚构。')
        .fontSize(FontSize.xxs).fontColor(this.theme.inkFaint).width('100%').textAlign(TextAlign.Center)
    }.width('100%').height('100%').justifyContent(FlexAlign.Start)
  }

  @Builder
  stat(label: string, value: string) {
    Column({ space: Space.xs }) {
      Text(label).fontSize(FontSize.xxs).fontColor(this.theme.inkFaint)
      Text(value).fontSize(FontSize.lg).fontWeight(FontWeight.Bold).fontColor(this.theme.ink)
    }.layoutWeight(1).padding(Space.sm)
    .backgroundColor(this.theme.surface).borderRadius(Radius.md).shadow(Shadow.card)
  }

  @Builder
  optBtn(i: number) {
    Text(this.opts[i].label)
      .fontSize(FontSize.md).fontWeight(FontWeight.Bold)
      .fontColor(this.pick === i ? '#FFFFFF' : this.theme.ink)
      .textAlign(TextAlign.Center).width('100%').height(Space.xxxl)
      .backgroundColor(this.pick === i ? (this.opts[i].ok ? Palette.emerald : Palette.rose) : this.theme.surfaceAlt)
      .borderRadius(Radius.md).shadow(Shadow.card)
      .scale({ x: this.pick === i ? Motion.pressScale : 1, y: this.pick === i ? Motion.pressScale : 1 })
      .animation({ duration: Motion.fast, curve: Motion.snap() })
      .onClick(() => { this.answer(i); })
  }
}
