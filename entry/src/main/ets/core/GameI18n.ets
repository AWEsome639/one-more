/**
 * 取当前语言下的文案。
 *
 * ★ 2026-10-13（P4 · 修奥森报的「繁體無效」时挖出的同类问题）：
 *   旧版写作 `if (!I18n.isEN()) return zh;` —— **中英二元式** ⇒
 *     · 繁体（zh-Hant）拿到的是**简体**：2,284 处游戏内文案一处都不转；
 *     · 其余 9 种语言（日/韩/西/法/德/葡/俄/意/阿）拿到的是**中文**。
 *   现在分四档：
 *     简体 → 原文（零开销）；English → 英文列；
 *     **繁体 → toTrad() 简→繁转换**（长尾文案也一起转）；
 *     其余 9 语言 → 英文列（比满屏中文强），英文列也没有才退原文。
 */
export function TG(zh: string): string {
  const cur: string = I18n.current();
  if (cur === Lang.ZH) {
    return zh;                       // 简体：原文（零开销）
  }
  const row: Record<string, string> | undefined = DICT[zh];
  if (row !== undefined) {
    const hit: string = row[cur];
    if (hit !== undefined) {
      return hit;                    // ⚠️ 空串合法（片段在目标语言里就该消失）
    }
  }
  if (cur === Lang.ZHTW) {
    return toTrad(zh);               // ★ 繁体：字典没有 zh-Hant 列，直接简→繁转换
  }
  if (row !== undefined) {
    const en: string = row['en'];
    if (en !== undefined) {
      return en;                     // 该语言缺译 ⇒ 退英文（好过满屏中文）
    }
  }
  return zh;                         // 字典外的长尾 ⇒ 原文
}

/**
 * ★★★ 2026-10-15 新增：**带占位符的文案**
 *
 * 起因：奥森「每种语言都要认真对待」⇒ 界面文案要全译。
 * 但大量文案是【拼接】的，例如：
 *     this.note = '已补 ' + n + '/' + PERIM + ' 格';
 * ★ 直接查字典不行 —— **各语言语序不同**：
 *     中文：'已补 ' + n + ' 格'
 *     英文：n + ' cells filled'
 *     日语：n + ' マス補充'
 * ⇒ 必须把拼接改成【带占位符的整句】再译。
 *
 * 用法：
 *     TG2('已补 {0}/{1} 格', n, PERIM)
 *     TG2('第 {0} 题', i)
 *     TG2('还剩 {0} 秒', sec)
 *
 * 字典里存的是【带 {0} {1} 的整句】（各语言自己排语序）：
 *     "已补 {0}/{1} 格": { "en": "{0}/{1} cells filled", ... }
 *
 * ⚠️ 为什么不用 Record<string,string> 传参（那样更好写）：
 *    ArkTS 的 arkts-no-untyped-obj-literals / 不支持遍历 Record 的键
 *    ⇒ 改成【位置参数】，最多 3 个（够覆盖现有 98% 的拼接）
 */
export function TG2(tpl: string, p0?: number | string, p1?: number | string, p2?: number | string): string {
  let out: string = TG(tpl);
  if (p0 !== undefined) {
    out = out.replace('{0}', `${p0}`);
  }
  if (p1 !== undefined) {
    out = out.replace('{1}', `${p1}`);
  }
  if (p2 !== undefined) {
    out = out.replace('{2}', `${p2}`);
  }
  return out;
}
