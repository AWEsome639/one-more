/** 难度系数 —— 影响一局获得的经验值 */
export function difficultyFactor(d: Difficulty): number {
  if (d === Difficulty.HARD) {
    return 1.5;
  }
  if (d === Difficulty.EASY) {
    return 0.8;
  }
  return 1.0;
}

/** 按分类取游戏（ALL 返回全部） */
// ★★★ 2026-10-18 23:1x 性能优化（第八轮 C 维度）：分类结果缓存
//   GAMES 是编译期静态表，同一个分类的结果永远不变 ⇒ 缓存后不必每次重扫 355 条
//   原来 categoryList() 一次要扫 7 × 355 = 2485 条，且在 build() 里被调用
const _catCache: Map<string, GameMeta[]> = new Map<string, GameMeta[]>();
export function gamesByCategory(cat: GameCategory): GameMeta[] {
  if (cat === GameCategory.ALL) {
    return GAMES;
  }
  const hit: GameMeta[] | undefined = _catCache.get(cat);
  if (hit !== undefined) {
    return hit;
  }
  const out: GameMeta[] = [];
  for (let i = 0; i < GAMES.length; i++) {
    if (GAMES[i].category === cat) {
      out.push(GAMES[i]);
    }
  }
  _catCache.set(cat, out);
  return out;
}

/** 按关键词搜索（匹配中文名 / 英文 id / 玩法描述） */
export function searchGames(q: string): GameMeta[] {
  const key: string = q.trim().toLowerCase();
  if (key.length === 0) {
    return GAMES;
  }
  const out: GameMeta[] = [];
  for (let i = 0; i < GAMES.length; i++) {
    const g: GameMeta = GAMES[i];
    if (g.name.indexOf(key) >= 0 || g.id.toLowerCase().indexOf(key) >= 0
      || g.tagline.indexOf(key) >= 0) {
      out.push(g);
    }
  }
  return out;
}

/** 按当前语言取游戏名 */
/**
 * 游戏名 —— 中文语言用中文名，**其余一律用国际通用英文名**
 * （奥森 2026-10-11 原话：「游戏名优先用国际通用英文名」）
 * ⚠️ 以前这里只判 'en' ⇒ 日语/韩语/西语… 下游戏名全是中文，直接违反「界面无残留中文」
 * ★ 2026-10-13（P4）：繁体不能直接返回简体名 —— 走 `toTrad()` 转成繁体
 *   （否则繁体用户在首页看到的是「扫雷/数独」这种简体名）
 */
export function displayName(g: GameMeta): string {
  // ★★★ 2026-10-16：改走 gameName() —— 9 种语言有真译名（原来一律 enName）
  return gameName(g.id, g.name, g.enName);
}

/** 按当前语言取一句话描述（繁体同样要转，别退简体） */
export function displayTagline(g: GameMeta): string {
  // ★★★ 2026-10-16：改走 gameTagline() —— 9 种语言有真译
  return gameTagline(g.id, g.tagline, g.enTagline);
}

/** 按 id 找 */
export function findGame(id: string): GameMeta | undefined {
  for (let i = 0; i < GAMES.length; i++) {
    if (GAMES[i].id === id) {
      return GAMES[i];
    }
  }
  return undefined;
}

/** 分类清单（含数量，用于筛选条） */
export interface CatCount {
  cat: GameCategory;
  count: number;
}

// ★★★ 同上：分类计数也缓存（只在首次调用时算一遍）
let _catCounts: CatCount[] | null = null;
export function categoryList(): CatCount[] {
  if (_catCounts !== null) {
    return _catCounts;
  }
  const cats: GameCategory[] = [
    GameCategory.ALL, GameCategory.CLASSIC, GameCategory.LOGIC,
    GameCategory.MATH, GameCategory.MEMORY, GameCategory.WORD, GameCategory.SPATIAL,
  ];
  const out: CatCount[] = [];
  for (let i = 0; i < cats.length; i++) {
    out.push({ cat: cats[i], count: gamesByCategory(cats[i]).length });
  }
  _catCounts = out;
  return out;
}

/** 分类的英文名（枚举值是中文，英文模式要单独映射） */
export function catLabelEn(c: GameCategory): string {
  if (c === GameCategory.ALL) {
    return 'All';
  }
  if (c === GameCategory.CLASSIC) {
    return 'Classic';
  }
  if (c === GameCategory.LOGIC) {
    return 'Logic';
  }
  if (c === GameCategory.MATH) {
    return 'Numbers';
  }
  if (c === GameCategory.MEMORY) {
    return 'Memory';
  }
  if (c === GameCategory.WORD) {
    return 'Words';
  }
  if (c === GameCategory.SPATIAL) {
    return 'Spatial';
  }
  return String(c);
}

/** 取色（hex 字符串） */
/**
 * ★ 2026-10-13（P5）：哨兵条目在这里读**实时**主题色（`Palette.primary/primaryDeep`），
 *   所以用户改主题色后这 59 款卡片立刻跟着变（详见文件顶部 ACCENT_TAG 的说明）。
 */
export function colorOf(g: GameMeta): string {
  if (g.color === ACCENT_TAG) {
    return Palette.primary;        // 实时读，选色后立刻跟
  }
  if (g.color === ACCENT_DEEP_TAG) {
    return Palette.primaryDeep;
  }
  return g.color;
}

/** 进场动画的错峰延时（毫秒），最多 400ms */
/**
 * ★★★ 构建水印（2026-10-14 新增）
 *   用途：奥森连说三次"还是闪现"而我看不到他屏幕 ⇒ 加个能一眼认版本的水印。
 *   ⚠️ 每次交付前【手动改这个字符串】（格式 月日-时分），构建后即为该版指纹。
 */
export const BUILD_TAG: string = 'v1014-1158';

export function enterDelay(index: number): number {
  const d: number = index * 40;
  return d > 400 ? 400 : d;
}

