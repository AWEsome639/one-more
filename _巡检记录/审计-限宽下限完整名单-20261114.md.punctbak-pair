## 附录 A：复算脚本（本次审计实际跑的那一份，只读）

```python
# -*- coding: utf-8 -*-
"""One More 限宽下限审计：注释遮罩 + 括号平衡 + 实参分类。只读。"""
import os, re
ROOT = "/Users/a0000/dev/One More/entry/src/main/ets"
DIRS = ["games", "components", "core", "pages"]
H = 533.0                     # 手机横屏基准 Bp.height

def mask(text):
    out, i, n, st = list(text), 0, len(text), "code"
    while i < n:
        c = text[i]; d = text[i+1] if i+1 < n else ""
        if st == "code":
            if c == "/" and d == "/": st = "line"; out[i] = out[i+1] = " "; i += 2; continue
            if c == "/" and d == "*": st = "block"; out[i] = out[i+1] = " "; i += 2; continue
            if c == "'": st = "s1"
            elif c == '"': st = "s2"
            elif c == "`": st = "tm"
            i += 1; continue
        if st == "line":
            if c == "\n": st = "code"
            else: out[i] = " "
            i += 1; continue
        if st == "block":
            if c == "*" and d == "/": out[i] = out[i+1] = " "; st = "code"; i += 2; continue
            if c != "\n": out[i] = " "
            i += 1; continue
        q = {"s1": "'", "s2": '"', "tm": "`"}[st]
        if c == "\\": i += 2; continue
        if c == q: st = "code"
        i += 1
    return "".join(out)

def calls(masked):
    for m in re.finditer(r"Math\.(max|min)\s*\(", masked):
        i = m.end() - 1; depth = 0; j = i
        while j < len(masked):
            if masked[j] == "(": depth += 1
            elif masked[j] == ")":
                depth -= 1
                if depth == 0: break
            j += 1
        if depth == 0: yield m.group(1), i + 1, j

def args(s):
    out, depth, cur = [], 0, ""
    for ch in s:
        if ch in "([{": depth += 1
        elif ch in ")]}": depth -= 1
        if ch == "," and depth == 0: out.append(cur.strip()); cur = ""
        else: cur += ch
    if cur.strip(): out.append(cur.strip())
    return out

NUM = r"\d+(?:\.\d+)?"
n_calls = n_max = n_lit = 0
binds = []
for d in DIRS:
    p = os.path.join(ROOT, d)
    if not os.path.isdir(p): continue
    for fn in sorted(os.listdir(p)):
        if not fn.endswith(".ets"): continue
        raw = open(os.path.join(p, fn), encoding="utf-8").read()
        msk = mask(raw)
        for kind, a, b in calls(msk):
            inner = msk[a:b]
            if "Bp.height" not in inner: continue
            n_calls += 1
            if kind != "max": continue
            n_max += 1
            ar = args(inner)
            if len(ar) < 2 or not re.fullmatch(NUM, ar[0]): continue
            m = re.fullmatch(rf"Bp\.height\s*-\s*({NUM})", ar[1])
            if not m: continue
            n_lit += 1
            bound, off = float(ar[0]), float(m.group(1))
            comp = H - off
            if bound > comp:
                line = raw.count("\n", 0, msk.rfind("Math.max", 0, a)) + 1
                binds.append((bound - comp, f"{d}/{fn}:{line}", bound, off, comp))

print(f"含 Bp.height 的 max/min 调用: {n_calls}（max {n_max}）")
print(f"字面量 Math.max(N, Bp.height-M): {n_lit}")
print(f"其中 bind: {len(binds)}")
for e, loc, bnd, off, comp in sorted(binds, key=lambda x: -x[0]):
    print(f"  {e:6.0f}vp  {loc:55s} max({bnd:.0f}, {H:.0f}-{off:.0f}={comp:.0f})")
