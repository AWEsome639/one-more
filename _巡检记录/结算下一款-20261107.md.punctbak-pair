animateTo(..., () => {
  this.showResult = false;  this.lastSolved = false;
  this.lastScore = 0; this.lastMs = 0; this.lastGain = 0; this.lastHintsUsed = 0;
  this.levelUpTo = 0; this.newAch = []; this.scoreShown = 0; this.gainShown = 0;
  this.finished = false;    // 新的一局：中途退出该补记就补记
  this.startedAt = Date.now();
  this.pop = false;         // 进场动画重播
  this.gameId = next;       // ★ 分发链是 if (gameId === 'xxx') ⇒ 换 id 就是换游戏
  this.nonce = this.nonce + 1;
  this.diffTick = this.diffTick + 1;   // 与「再来一局」同一套奇偶翻转 ⇒ 子组件销毁重建、autoId 归零
});
setTimeout(() => { this.pop = true; }, Motion.base + 40);
```

⚠️ 这 12 行清理是**必须**的：不清 `showResult/lastSolved/lastScore/lastMs` 就会复现
`aboutToAppear` 里记录的那个真机 bug（判据 1762）——新游戏一进来顶着上一局的「🎉 这一局拿下！」。

