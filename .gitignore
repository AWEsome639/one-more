# ═══════════════════════════════════════════
#  白名单策略：先忽略一切，再放行要公开的
# ═══════════════════════════════════════════
/*

# ── 放行：源码 ──
!/entry/
!/entry/src/
!/entry/src/**
!/entry/oh-package.json5
!/entry/hvigorfile.ts
!/entry/obfuscation-rules.txt
!/entry/build-profile.json5.example
!/AppScope/
!/AppScope/**
!/hvigor/
!/hvigorfile.ts
!/oh-package.json5
!/oh-package-lock.json5
!/code-linter.json5
!/build-profile.json5.example
!/build.sh

# ── 放行：文档与资源 ──
!/README.md
!/LICENSE
!/GAME_BRIEF.md
!/docs/
!/docs/**
!/tools/
!/tools/**

# ── 放行：.gitignore 本身 ──
!/.gitignore
!/\.github/
!/\.github/**

# ═══════════════════════════════════════════
#  例外中的例外
# ═══════════════════════════════════════════
entry/build/
entry/oh_modules/
oh_modules/
node_modules/
**/*.p12
**/*.p7b
**/*.cer
**/*.csr
**/*.key
**/*.hap
**/*.app
**/*.abc
**/.DS_Store
**/*.log
__pycache__/

# 备份文件不进仓库（2026-10-20）：260 个 .bak / 57,604 行 / 2.5 MB，没有代码价值
entry/src/main/ets/games/*.bak*
工具/models/

# 归档的已签名发布包（29.5MB，不进 git；构建目录里的同名文件会被后续 debug 编译覆盖）
release/

# 跑批生成的临时 dump（每次测量重写，属生成物，不入库）
_巡检记录/dumps/

# 编译产物（2026-11-19：`git add -f 工具/` 时误把 .pyc 带进过库）
*.pyc
__pycache__/
